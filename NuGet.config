<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github-famick" value="https://nuget.pkg.github.com/Famick-com/index.json" />
  </packageSources>
  <!-- Each package comes from exactly one feed. Only the Kroger plugin is published to
       GitHub Packages; Plugin.Abstractions is on nuget.org, so it falls under "*".
       Required under central package management (NU1507), and stops a same-named
       package on the other feed from shadowing ours. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github-famick">
      <package pattern="Famick.HomeManagement.Plugin.Kroger" />
    </packageSource>
  </packageSourceMapping>
</configuration>
