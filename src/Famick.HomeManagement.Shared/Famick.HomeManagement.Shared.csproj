<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(FamickTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- IOptions<T> for RedirectUrlValidator. Pulls in nothing beyond the
         abstractions; no runtime config provider attached at this layer. -->
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- ICaptchaService (Phase 4 chunk 4.B): config binding, logger, DI extension. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Phase 4 chunk 4.C — distributed cache for /check rate-limit + CAPTCHA gate counters. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
  </ItemGroup>

</Project>
