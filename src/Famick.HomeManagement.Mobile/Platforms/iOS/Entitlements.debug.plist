<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Application Identifier (TeamID.BundleID) -->
	<key>application-identifier</key>
	<string>7A6WPZLCK9.com.famick.homemanagement</string>
	<!-- Sign in with Apple capability -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Associated Domains for Password AutoFill + WebAuthn (passkey) +
	     Universal Links. Debug builds run against staging via DynamicApiHttpHandler,
	     so staging-app.famick.com is included alongside app.famick.com — both AASA
	     files declare the same bundle ID, so the OS will match either depending
	     on which host the build targets. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:app.famick.com</string>
		<string>applinks:app.famick.com</string>
		<string>webcredentials:staging-app.famick.com</string>
		<string>applinks:staging-app.famick.com</string>
	</array>
	<!-- App Group for sharing data with widget extension -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.famick.homemanagement</string>
	</array>
	<!-- Shared keychain for widget extension access to JWT tokens -->
	<key>keychain-access-groups</key>
	<array>
		<string>7A6WPZLCK9.com.famick.homemanagement.shared</string>
	</array>
	<!-- Push Notifications: development environment for Debug builds -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
