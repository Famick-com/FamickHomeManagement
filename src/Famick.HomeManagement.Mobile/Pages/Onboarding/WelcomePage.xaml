<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Famick.HomeManagement.Mobile.Pages.Onboarding.WelcomePage"
             Title="Welcome"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">

            <!-- App Logo/Title -->
            <Image Source="famick_logo"
                   HeightRequest="80"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10" />

            <Label Text="Welcome to Famick"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{toolkit:AppThemeResource BrandForeground}" />

            <Label x:Name="SubtitleLabel"
                   Text="Create your household to get started"
                   FontSize="16"
                   HorizontalOptions="Center"
                   TextColor="{toolkit:AppThemeResource TextMuted}"
                   Margin="0,0,0,20" />

            <!-- Household Info -->
            <Frame x:Name="RegistrationFrame" Padding="15" CornerRadius="10" HasShadow="False"
                   BackgroundColor="{toolkit:AppThemeResource SurfaceRaised}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Household Name" FontSize="14" FontAttributes="Bold" />
                    <Entry x:Name="HouseholdNameEntry"
                           Placeholder="e.g., The Smiths, Beach House"
                           IsTextPredictionEnabled="False" />

                    <Label Text="Your Email" FontSize="14" FontAttributes="Bold" />
                    <Entry x:Name="EmailEntry"
                           Placeholder="email@example.com"
                           Keyboard="Email"
                           IsTextPredictionEnabled="False" />
                </VerticalStackLayout>
            </Frame>

            <!-- Error Message -->
            <Label x:Name="ErrorLabel"
                   TextColor="Red"
                   FontSize="14"
                   HorizontalOptions="Center"
                   IsVisible="False" />

            <!-- Next Button -->
            <Button x:Name="NextButton"
                    Text="Next"
                    Clicked="OnNextClicked"
                    BackgroundColor="{toolkit:AppThemeResource BrandFill}"
                    TextColor="White"
                    FontSize="18"
                    HeightRequest="50"
                    CornerRadius="25" />

            <!-- Loading Indicator -->
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="{toolkit:AppThemeResource BrandForeground}" />

            <!-- Separator -->
            <BoxView HeightRequest="1"
                     BackgroundColor="{toolkit:AppThemeResource Divider}"
                     Margin="0,10" />

            <!-- QR Code Option -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Already have an account?"
                       FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="{toolkit:AppThemeResource TextMuted}" />

                <Button Text="Sign In"
                        Clicked="OnSignInClicked"
                        BackgroundColor="Transparent"
                        TextColor="{toolkit:AppThemeResource BrandForeground}"
                        FontSize="16" />

                <!-- The QR code is the self-hosted path, which means nothing to someone who
                     has not set up a server, so the help sits next to it rather than below.
                     The circle overrides the global Button style's 44pt minimums and padding,
                     which would otherwise stretch it out of round. -->
                <HorizontalStackLayout HorizontalOptions="Center"
                                       Spacing="6">
                    <Button x:Name="QrCodeButton"
                            Text="I have a QR Code"
                            Clicked="OnQrCodeClicked"
                            BackgroundColor="Transparent"
                            TextColor="{toolkit:AppThemeResource BrandForeground}"
                            FontSize="16"
                            VerticalOptions="Center" />

                    <Button x:Name="WhatsThisButton"
                            Text="?"
                            Clicked="OnWhatsThisClicked"
                            BackgroundColor="Transparent"
                            TextColor="{toolkit:AppThemeResource TextMuted}"
                            BorderColor="{toolkit:AppThemeResource TextMuted}"
                            BorderWidth="1"
                            FontSize="14"
                            Padding="0"
                            WidthRequest="30"
                            HeightRequest="30"
                            MinimumWidthRequest="30"
                            MinimumHeightRequest="30"
                            CornerRadius="15"
                            VerticalOptions="Center"
                            SemanticProperties.Description="What is a QR code sign-in?" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
