<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Famick.HomeManagement.Mobile.Models"
             xmlns:controls="clr-namespace:Famick.HomeManagement.Mobile.Controls"
             xmlns:dataForm="clr-namespace:Syncfusion.Maui.DataForm;assembly=Syncfusion.Maui.DataForm"
             xmlns:sfCore="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             x:Class="Famick.HomeManagement.Mobile.Pages.Contacts.ContactGroupEditPage"
             Title="New Household"
             Shell.NavBarIsVisible="True">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Clicked="OnSaveClicked" />
    </ContentPage.ToolbarItems>

    <Grid Padding="16" RowDefinitions="*,Auto">
        <dataForm:SfDataForm x:Name="ContactForm"
                             Grid.Row="0"
                             AutoGenerateItems="False"
                             LayoutType="TextInputLayout"
                             CommitMode="PropertyChanged">
                <dataForm:SfDataForm.EditorTextStyle>
                    <dataForm:DataFormTextStyle TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                </dataForm:SfDataForm.EditorTextStyle>
                <dataForm:SfDataForm.LabelTextStyle>
                    <dataForm:DataFormTextStyle TextColor="{AppThemeBinding Light=#555, Dark=#E0E0E0}" />
                </dataForm:SfDataForm.LabelTextStyle>
                <dataForm:SfDataForm.TextInputLayoutSettings>
                    <dataForm:TextInputLayoutSettings
                        ContainerType="Outlined"
                        Stroke="{AppThemeBinding Light=#BDBDBD, Dark=#616161}"
                        FocusedStroke="{AppThemeBinding Light=#518751, Dark=#64B5F6}">
                        <dataForm:TextInputLayoutSettings.HelperTextStyle>
                            <dataForm:DataFormTextStyle TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}" />
                        </dataForm:TextInputLayoutSettings.HelperTextStyle>
                    </dataForm:TextInputLayoutSettings>
                </dataForm:SfDataForm.TextInputLayoutSettings>
                <dataForm:SfDataForm.Items>

                    <!-- Type selection (SfChipGroup) -->
                    <dataForm:DataFormCustomItem x:Name="TypeItem"
                                                 FieldName="ContactType"
                                                 ShowLabel="False">
                        <dataForm:DataFormCustomItem.EditorView>
                            <Grid ColumnDefinitions="40,*" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="&#xe71b;" FontFamily="MaterialAssets"
                                       FontSize="18"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Start"
                                       TextColor="Gray"
                                       Padding="8,0,0,0" />
                                <sfCore:SfChipGroup Grid.Column="1"
                                                    x:Name="TypeChipGroup"
                                                    ChipType="Choice"
                                                    SelectionChanged="OnTypeChipChanged"
                                                    ChipBackground="{AppThemeBinding Light=#E0E0E0, Dark=#424242}"
                                                    ChipTextColor="{AppThemeBinding Light=#333, Dark=#EEE}"
                                                    SelectedChipBackground="{AppThemeBinding Light=#518751, Dark=#3D6B3D}"
                                                    SelectedChipTextColor="White"
                                                    HorizontalOptions="Start">
                                    <sfCore:SfChipGroup.Items>
                                        <sfCore:SfChip Text="Household"
                                                       BackgroundColor="{StaticResource HouseholdColor}"
                                                       Stroke="{StaticResource HouseholdColor}" />
                                        <sfCore:SfChip Text="Business"
                                                       BackgroundColor="{StaticResource BusinessColor}"
                                                       Stroke="{StaticResource BusinessColor}" />
                                    </sfCore:SfChipGroup.Items>
                                </sfCore:SfChipGroup>
                            </Grid>
                        </dataForm:DataFormCustomItem.EditorView>
                    </dataForm:DataFormCustomItem>

                    <!-- Name -->
                    <dataForm:DataFormTextItem x:Name="NameItem"
                                               FieldName="GroupName"
                                               LabelText="Household Name"
                                               PlaceholderText="e.g. Smith Family"
                                               ShowLeadingView="True">
                        <dataForm:DataFormTextItem.LeadingView>
                            <Label Text="&#xe71b;" FontFamily="MaterialAssets"
                                   FontSize="18"
                                   HeightRequest="24"
                                   VerticalTextAlignment="End"
                                   TextColor="Gray" />
                        </dataForm:DataFormTextItem.LeadingView>
                    </dataForm:DataFormTextItem>

                    <!-- Website (business only) -->
                    <dataForm:DataFormTextItem x:Name="WebsiteItem"
                                               FieldName="Website"
                                               LabelText="Website"
                                               PlaceholderText="https://example.com"
                                               Keyboard="Url"
                                               IsVisible="False"
                                               ShowLeadingView="True">
                        <dataForm:DataFormTextItem.LeadingView>
                            <Label Text="&#xe71a;" FontFamily="MaterialAssets"
                                   FontSize="18"
                                   HeightRequest="24"
                                   VerticalTextAlignment="End"
                                   TextColor="Gray" />
                        </dataForm:DataFormTextItem.LeadingView>
                    </dataForm:DataFormTextItem>

                    <!-- Business Category (business only) -->
                    <dataForm:DataFormTextItem x:Name="CategoryItem"
                                               FieldName="BusinessCategory"
                                               LabelText="Business Category"
                                               PlaceholderText="e.g. Restaurant, Contractor"
                                               IsVisible="False"
                                               ShowLeadingView="True">
                        <dataForm:DataFormTextItem.LeadingView>
                            <Label Text="&#xe71c;" FontFamily="MaterialAssets"
                                   FontSize="18"
                                   HeightRequest="24"
                                   VerticalTextAlignment="End"
                                   TextColor="Gray" />
                        </dataForm:DataFormTextItem.LeadingView>
                    </dataForm:DataFormTextItem>

                    <!-- Phone (custom editor) -->
                    <dataForm:DataFormCustomItem FieldName="PhoneNumber"
                                                 ShowLabel="False">
                        <dataForm:DataFormCustomItem.EditorView>
                            <Grid ColumnDefinitions="40,*" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="&#xe718;" FontFamily="MaterialAssets"
                                       FontSize="18"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Start"
                                       TextColor="Gray"
                                       Padding="8,0,0,0" />
                                <controls:PhoneNumberEditor Grid.Column="1"
                                                            x:Name="PrimaryPhoneEditor"
                                                            Value="{Binding PhoneNumber, Mode=TwoWay}"
                                                            HorizontalOptions="Fill" />
                            </Grid>
                        </dataForm:DataFormCustomItem.EditorView>
                    </dataForm:DataFormCustomItem>

                    <!-- Address (create mode) -->
                    <dataForm:DataFormGroupItem x:Name="AddressGroup" Name="Address">
                        <dataForm:DataFormGroupItem.Items>
                            <dataForm:DataFormCustomItem FieldName="Address" ShowLabel="False">
                                <dataForm:DataFormCustomItem.EditorView>
                                    <Grid ColumnDefinitions="40,*" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="&#xe756;" FontFamily="MaterialAssets"
                                               FontSize="18"
                                               VerticalTextAlignment="Start"
                                               HorizontalTextAlignment="Start"
                                               TextColor="Gray" />
                                        <controls:AddressAutocompleteField Grid.Column="1"
                                                                           x:Name="AddressAutocomplete" />
                                    </Grid>
                                </dataForm:DataFormCustomItem.EditorView>
                            </dataForm:DataFormCustomItem>
                        </dataForm:DataFormGroupItem.Items>
                    </dataForm:DataFormGroupItem>

                    <!-- Notes -->
                    <dataForm:DataFormMultilineItem FieldName="Notes"
                                                    LabelText="Notes"
                                                    PlaceholderText="Optional notes..." >
                        <dataForm:DataFormMultilineItem.LeadingView>
                            <Label Text="&#xe713;" FontFamily="MaterialAssets"
                                   FontSize="18"
                                   HeightRequest="24"
                                   VerticalTextAlignment="Start"
                                   TextColor="Gray" />
                        </dataForm:DataFormMultilineItem.LeadingView>
                    </dataForm:DataFormMultilineItem>

                    <!-- Tags -->
                    <dataForm:DataFormCustomItem FieldName="Tags"
                                                 ShowLabel="False">
                        <dataForm:DataFormCustomItem.EditorView>
                            <Grid ColumnDefinitions="40,*" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="&#xe71c;" FontFamily="MaterialAssets"
                                       FontSize="18"
                                       VerticalTextAlignment="Start"
                                       HorizontalTextAlignment="Start"
                                       TextColor="Gray" />
                                <FlexLayout Grid.Column="1"
                                            x:Name="TagsLayout"
                                            Wrap="Wrap" JustifyContent="Start" Direction="Row" />
                            </Grid>
                        </dataForm:DataFormCustomItem.EditorView>
                    </dataForm:DataFormCustomItem>

                    <!-- First Member group (create mode) -->
                    <dataForm:DataFormGroupItem x:Name="MemberGroup" Name="First Member (optional)">
                        <dataForm:DataFormGroupItem.Items>
                            <dataForm:DataFormTextItem FieldName="MemberFirstName"
                                                       LabelText="First Name"
                                                       PlaceholderText="First Name"
                                                       ShowLeadingView="True">
                                <dataForm:DataFormTextItem.LeadingView>
                                    <Label Text="&#xe71b;" FontFamily="MaterialAssets"
                                           FontSize="18"
                                           HeightRequest="24"
                                           VerticalTextAlignment="End"
                                           TextColor="Gray" />
                                </dataForm:DataFormTextItem.LeadingView>
                            </dataForm:DataFormTextItem>

                            <dataForm:DataFormTextItem FieldName="MemberLastName"
                                                       LabelText="Last Name"
                                                       PlaceholderText="Last Name" />

                            <dataForm:DataFormTextItem FieldName="MemberEmail"
                                                       LabelText="Email"
                                                       PlaceholderText="Email"
                                                       Keyboard="Email"
                                                       ShowLeadingView="True">
                                <dataForm:DataFormTextItem.LeadingView>
                                    <Label Text="&#xe717;" FontFamily="MaterialAssets"
                                           FontSize="18"
                                           HeightRequest="24"
                                           VerticalTextAlignment="End"
                                           TextColor="Gray" />
                                </dataForm:DataFormTextItem.LeadingView>
                            </dataForm:DataFormTextItem>

                            <dataForm:DataFormCustomItem FieldName="MemberPhone"
                                                         ShowLabel="False">
                                <dataForm:DataFormCustomItem.EditorView>
                                    <Grid ColumnDefinitions="40,*" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="&#xe718;" FontFamily="MaterialAssets"
                                               FontSize="18"
                                               VerticalTextAlignment="Center"
                                               HorizontalTextAlignment="Start"
                                               TextColor="Gray" />
                                        <controls:PhoneNumberEditor Grid.Column="1"
                                                                    x:Name="MemberPhoneEditor"
                                                                    Value="{Binding MemberPhone, Mode=TwoWay}"
                                                                    HorizontalOptions="Fill" />
                                    </Grid>
                                </dataForm:DataFormCustomItem.EditorView>
                            </dataForm:DataFormCustomItem>
                        </dataForm:DataFormGroupItem.Items>
                    </dataForm:DataFormGroupItem>

                </dataForm:SfDataForm.Items>
            </dataForm:SfDataForm>

        <ActivityIndicator x:Name="SavingIndicator" Grid.Row="1"
                           IsRunning="False" IsVisible="False"
                           HorizontalOptions="Center"
                           Color="{AppThemeBinding Light=#518751, Dark=#7BA17C}" />
    </Grid>

</ContentPage>
