<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Famick.HomeManagement.Mobile.Pages.SettingsPage"
             Title="Settings"
             Shell.NavBarIsVisible="True"
             Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="0" Spacing="0">

            <Label Text="Settings"
                   FontSize="24"
                   FontAttributes="Bold"
                   Padding="20,30,20,15"
                   TextColor="{toolkit:AppThemeResource TextPrimary}" />

            <!-- Settings List -->
            <Border StrokeShape="RoundRectangle 12" Stroke="Transparent" Margin="15,0"
                    BackgroundColor="{toolkit:AppThemeResource Surface}">
                <VerticalStackLayout Spacing="0">

                    <!-- Home Setup -->
                    <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHomeSetupTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="&#x1F3E0;" FontSize="22" VerticalOptions="Center"
                               Margin="0,0,14,0" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Home Setup" FontSize="15" FontAttributes="Bold"
                                   TextColor="{toolkit:AppThemeResource TextPrimary}" />
                            <Label Text="Re-run the setup wizard" FontSize="13"
                                   TextColor="{toolkit:AppThemeResource TextMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="&#x276F;" FontSize="16" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#CCCCCC, Dark=#666666}" />
                    </Grid>

                    <BoxView HeightRequest="1" Margin="50,0,16,0"
                             BackgroundColor="{AppThemeBinding Light=#E8E8E8, Dark=#3A3A3A}" />

                    <!-- Meal Planner -->
                    <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMealPlannerTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="&#x1F37D;" FontSize="22" VerticalOptions="Center"
                               Margin="0,0,14,0" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Meal Planner" FontSize="15" FontAttributes="Bold"
                                   TextColor="{toolkit:AppThemeResource TextPrimary}" />
                            <Label Text="Manage meal types, view your meal plan, and configure preferences." FontSize="13"
                                   TextColor="{toolkit:AppThemeResource TextMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="&#x276F;" FontSize="16" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#CCCCCC, Dark=#666666}" />
                    </Grid>

                    <BoxView HeightRequest="1" Margin="50,0,16,0"
                             BackgroundColor="{AppThemeBinding Light=#E8E8E8, Dark=#3A3A3A}" />

                    <!-- Grocery Catalog -->
                    <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGroceryCatalogTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="&#x1F6D2;" FontSize="22" VerticalOptions="Center"
                               Margin="0,0,14,0" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Grocery Catalog" FontSize="15" FontAttributes="Bold"
                                   TextColor="{toolkit:AppThemeResource TextPrimary}" />
                            <Label Text="Set up your grocery product catalog" FontSize="13"
                                   TextColor="{toolkit:AppThemeResource TextMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="&#x276F;" FontSize="16" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#CCCCCC, Dark=#666666}" />
                    </Grid>

                    <BoxView HeightRequest="1" Margin="50,0,16,0"
                             BackgroundColor="{AppThemeBinding Light=#E8E8E8, Dark=#3A3A3A}" />

                    <!-- Notifications -->
                    <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNotificationsTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="&#x1F514;" FontSize="22" VerticalOptions="Center"
                               Margin="0,0,14,0" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Notifications" FontSize="15" FontAttributes="Bold"
                                   TextColor="{toolkit:AppThemeResource TextPrimary}" />
                            <Label Text="Configure how notifications are sent to you" FontSize="13"
                                   TextColor="{toolkit:AppThemeResource TextMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="&#x276F;" FontSize="16" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#CCCCCC, Dark=#666666}" />
                    </Grid>

                    <BoxView HeightRequest="1" Margin="50,0,16,0"
                             BackgroundColor="{AppThemeBinding Light=#E8E8E8, Dark=#3A3A3A}" />

                    <!-- Barcode Scanner -->
                    <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBarcodeScannerTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="&#x1F4F7;" FontSize="22" VerticalOptions="Center"
                               Margin="0,0,14,0" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Barcode Scanner" FontSize="15" FontAttributes="Bold"
                                   TextColor="{toolkit:AppThemeResource TextPrimary}" />
                            <Label Text="Configure a barcode scanner" FontSize="13"
                                   TextColor="{toolkit:AppThemeResource TextMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="&#x276F;" FontSize="16" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#CCCCCC, Dark=#666666}" />
                    </Grid>

                    <BoxView HeightRequest="1" Margin="50,0,16,0"
                             BackgroundColor="{AppThemeBinding Light=#E8E8E8, Dark=#3A3A3A}" />

                    <!-- Storage Locations -->
                    <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStorageLocationsTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="&#x1F4E6;" FontSize="22" VerticalOptions="Center"
                               Margin="0,0,14,0" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Storage Locations" FontSize="15" FontAttributes="Bold"
                                   TextColor="{toolkit:AppThemeResource TextPrimary}" />
                            <Label Text="Manage where items are stored" FontSize="13"
                                   TextColor="{toolkit:AppThemeResource TextMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="&#x276F;" FontSize="16" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#CCCCCC, Dark=#666666}" />
                    </Grid>

                    <BoxView HeightRequest="1" Margin="50,0,16,0"
                             BackgroundColor="{AppThemeBinding Light=#E8E8E8, Dark=#3A3A3A}" />

                    <!-- Stores -->
                    <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStoresTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="&#x1F3EA;" FontSize="22" VerticalOptions="Center"
                               Margin="0,0,14,0" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Stores" FontSize="15" FontAttributes="Bold"
                                   TextColor="{toolkit:AppThemeResource TextPrimary}" />
                            <Label Text="Manage your shopping locations" FontSize="13"
                                   TextColor="{toolkit:AppThemeResource TextMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="&#x276F;" FontSize="16" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#CCCCCC, Dark=#666666}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Phase 4 chunk 4.H — Connectivity (self-hosted only) -->
            <Border x:Name="ConnectivitySection"
                    IsVisible="False"
                    StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    Margin="15,20,15,0"
                    BackgroundColor="{toolkit:AppThemeResource Surface}">
                <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto">
                    <Label Grid.Column="0" Text="&#x1F310;" FontSize="22" VerticalOptions="Center"
                           Margin="0,0,14,0" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="Use proxy only" FontSize="15" FontAttributes="Bold"
                               TextColor="{toolkit:AppThemeResource TextPrimary}" />
                        <Label Text="Skip the LAN probe and always route via proxy.famick.com. Useful on flaky Wi-Fi." FontSize="13"
                               TextColor="{toolkit:AppThemeResource TextMuted}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="2"
                            x:Name="UseProxyOnlySwitch"
                            OnColor="{toolkit:AppThemeResource BrandFill}"
                            VerticalOptions="Center"
                            Toggled="OnUseProxyOnlyToggled" />
                </Grid>
            </Border>

            <!-- About -->
            <Border StrokeShape="RoundRectangle 12" Stroke="Transparent" Margin="15,20,15,30"
                    BackgroundColor="{toolkit:AppThemeResource Surface}">
                <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAboutTapped" />
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" Text="&#x2139;&#xFE0F;" FontSize="22" VerticalOptions="Center"
                           Margin="0,0,14,0" />
                    <Label Grid.Column="1" Text="About Famick Home" FontSize="15" FontAttributes="Bold"
                           VerticalOptions="Center"
                           TextColor="{toolkit:AppThemeResource TextPrimary}" />
                    <Label Grid.Column="2" Text="&#x276F;" FontSize="16" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#CCCCCC, Dark=#666666}" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
