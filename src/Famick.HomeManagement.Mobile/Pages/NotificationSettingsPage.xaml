<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Famick.HomeManagement.Mobile.Pages.NotificationSettingsPage"
             Title="Notification Settings"
             Shell.NavBarIsVisible="True">

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0">

            <Label Text="Notification Settings"
                   FontSize="24"
                   FontAttributes="Bold"
                   Padding="20,30,20,10"
                   TextColor="{toolkit:AppThemeResource TextPrimary}" />

            <Label Text="Choose how you want to receive notifications."
                   FontSize="13"
                   Padding="20,0,20,15"
                   TextColor="{toolkit:AppThemeResource TextMuted}" />

            <!-- Loading -->
            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False"
                               HeightRequest="30" Margin="0,20"
                               Color="{toolkit:AppThemeResource BrandForeground}" />

            <!-- Preference Items -->
            <Border x:Name="PrefsContainer" StrokeShape="RoundRectangle 12" Stroke="Transparent" Margin="15,0"
                    BackgroundColor="{toolkit:AppThemeResource Surface}" IsVisible="False">
                <VerticalStackLayout x:Name="PrefsStack" Spacing="0" />
            </Border>

            <!-- Offline reminders (self-hosted mode only) -->
            <Border x:Name="OfflineRemindersSection" StrokeShape="RoundRectangle 12" Stroke="Transparent"
                    Margin="15,15,15,0" IsVisible="False"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}">
                <VerticalStackLayout Spacing="4" Padding="16,12">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="Offline reminders" FontSize="14" FontAttributes="Bold"
                               VerticalOptions="Center" HorizontalOptions="StartAndExpand"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Switch x:Name="OfflineRemindersSwitch" Toggled="OnOfflineRemindersToggled"
                                OnColor="#1976D2" />
                    </HorizontalStackLayout>
                    <Label Text="Schedule reminders on this device so they alert you even without a network connection."
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#999999}" />
                </VerticalStackLayout>
            </Border>

            <!-- View All Notifications Button -->
            <Button Text="View All Notifications"
                    Clicked="OnViewAllNotificationsClicked"
                    BackgroundColor="Transparent"
                    BorderColor="{toolkit:AppThemeResource BrandForeground}"
                    BorderWidth="2"
                    TextColor="{toolkit:AppThemeResource BrandForeground}"
                    CornerRadius="8" HeightRequest="44"
                    Margin="15,20,15,30" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
