<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Famick.HomeManagement.Mobile.Pages.AboutPage"
             Title="About"
             Shell.NavBarIsVisible="True">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- App Info -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="4" Padding="0,10,0,20">
                <Label Text="Famick Home Management" FontSize="24" FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{toolkit:AppThemeResource BrandForeground}" />
                <Label x:Name="VersionLabel" FontSize="14" HorizontalTextAlignment="Center"
                       TextColor="{toolkit:AppThemeResource TextMuted}" />
                <Label x:Name="HouseholdLabel" FontSize="14" HorizontalTextAlignment="Center"
                       TextColor="{toolkit:AppThemeResource TextMuted}"
                       IsVisible="False" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="{toolkit:AppThemeResource Divider}" />

            <!-- Open Source Licenses -->
            <Label Text="Open Source Licenses" FontSize="18" FontAttributes="Bold"
                   TextColor="{toolkit:AppThemeResource TextPrimary}"
                   Padding="0,8,0,4" />
            <Label Text="This app is built with the following open source libraries:"
                   FontSize="13"
                   TextColor="{toolkit:AppThemeResource TextMuted}" />

            <VerticalStackLayout x:Name="LicensesList" Spacing="8" />

            <!-- Syncfusion -->
            <BoxView HeightRequest="1" Color="{toolkit:AppThemeResource Divider}"
                     Margin="0,8" />
            <Label Text="Commercial Libraries" FontSize="18" FontAttributes="Bold"
                   TextColor="{toolkit:AppThemeResource TextPrimary}"
                   Padding="0,8,0,4" />
            <VerticalStackLayout x:Name="CommercialList" Spacing="8" />

            <BoxView HeightRequest="30" Color="Transparent" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
