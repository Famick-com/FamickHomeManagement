<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Famick.HomeManagement.Mobile.Pages.LoginPage"
             Title="Login"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">

            <!-- App Logo -->
            <Image Source="famick_logo"
                   Aspect="AspectFit"
                   HeightRequest="80"
                   HorizontalOptions="Center" />

            <!-- Tenant/Household Name -->
            <Frame x:Name="TenantFrame"
                   Padding="10"
                   CornerRadius="8"
                   HasShadow="False"
                   BackgroundColor="{toolkit:AppThemeResource InfoSurface}"
                   IsVisible="False">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Label Text="Signing in to"
                           FontSize="14"
                           TextColor="{toolkit:AppThemeResource BrandForeground}"
                           VerticalOptions="Center" />
                    <Label x:Name="TenantNameLabel"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{toolkit:AppThemeResource BrandForeground}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Frame>

            <Label Text="Sign in to continue"
                   FontSize="16"
                   HorizontalOptions="Center"
                   TextColor="{toolkit:AppThemeResource TextMuted}"
                   Margin="0,0,0,10" />

            <!-- Credentials -->
            <Frame Padding="15" CornerRadius="10" HasShadow="False"
                   BackgroundColor="{toolkit:AppThemeResource Surface}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Email" FontSize="14" FontAttributes="Bold" />
                    <Entry x:Name="EmailEntry"
                           Placeholder="email@example.com"
                           Keyboard="Email"
                           IsTextPredictionEnabled="False" />

                    <!-- Proxied-mode "go back" link. Shown after Continue
                         resolves the email to a home server; tapping reverts
                         the UI to the email-entry step so the user can pick
                         a different account / home server. -->
                    <Label x:Name="ChangeEmailLink"
                           Text="Change email"
                           FontSize="12"
                           TextColor="{toolkit:AppThemeResource BrandForeground}"
                           TextDecorations="Underline"
                           HorizontalOptions="End"
                           IsVisible="False">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChangeEmailTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Phase 4 chunk 4.F — password section hidden in two-step mode
                         until the user taps Continue and /check completes. -->
                    <VerticalStackLayout x:Name="PasswordSection" Spacing="15">
                        <Label Text="Password" FontSize="14" FontAttributes="Bold" />
                        <Entry x:Name="PasswordEntry"
                               Placeholder="Password"
                               IsPassword="True"
                               IsTextPredictionEnabled="False" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Error Message -->
            <Label x:Name="ErrorLabel"
                   TextColor="Red"
                   FontSize="14"
                   HorizontalOptions="Center"
                   IsVisible="False" />

            <!-- Phase 4 chunk 4.F — Continue button shown in two-step mode
                 before /check resolves; hidden after, when LoginButton takes over. -->
            <Button x:Name="ContinueButton"
                    Text="Continue"
                    IsVisible="False"
                    Clicked="OnContinueClicked"
                    BackgroundColor="{toolkit:AppThemeResource BrandFill}"
                    TextColor="White"
                    FontSize="18"
                    HeightRequest="50"
                    CornerRadius="25" />

            <!-- Login Button -->
            <Button x:Name="LoginButton"
                    Text="Sign In"
                    Clicked="OnLoginClicked"
                    BackgroundColor="{toolkit:AppThemeResource BrandFill}"
                    TextColor="White"
                    FontSize="18"
                    HeightRequest="50"
                    CornerRadius="25" />

            <!-- Loading Indicator -->
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="{toolkit:AppThemeResource BrandForeground}" />

            <!-- OAuth Section (dynamically populated) -->
            <VerticalStackLayout x:Name="OAuthSection" IsVisible="False" Spacing="15">
                <BoxView HeightRequest="1"
                         BackgroundColor="{toolkit:AppThemeResource Divider}"
                         Margin="0,5" />
                <FlexLayout x:Name="OAuthButtonsContainer"
                            Wrap="Wrap"
                            JustifyContent="Center"
                            AlignItems="Center" />
            </VerticalStackLayout>

            <!-- Create Account (cloud users only) -->
            <VerticalStackLayout x:Name="CreateAccountSection" IsVisible="False" Spacing="5">
                <BoxView HeightRequest="1"
                         BackgroundColor="{toolkit:AppThemeResource Divider}"
                         Margin="0,10" />
                <Label Text="Don't have an account?"
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       TextColor="{toolkit:AppThemeResource TextMuted}" />
                <Button Text="Create Account"
                        Clicked="OnCreateAccountClicked"
                        BackgroundColor="Transparent"
                        TextColor="{toolkit:AppThemeResource BrandForeground}"
                        FontSize="16" />
            </VerticalStackLayout>

            <!-- Server Settings Link (for self-hosted users) -->
            <VerticalStackLayout x:Name="ServerSettingsSection" IsVisible="False" Spacing="5">
                <BoxView HeightRequest="1"
                         BackgroundColor="{toolkit:AppThemeResource Divider}"
                         Margin="0,10" />
                <Label x:Name="ServerInfoLabel"
                       FontSize="12"
                       HorizontalTextAlignment="Center"
                       TextColor="{toolkit:AppThemeResource TextMuted}" />
                <Label Text="Change server"
                       FontSize="12"
                       TextColor="{toolkit:AppThemeResource BrandForeground}"
                       TextDecorations="Underline"
                       HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnChangeServerTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
