<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Famick.HomeManagement.Mobile.Pages.StepUpReauthPage"
             Title="Confirm your identity"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">

            <Image Source="famick_logo"
                   Aspect="AspectFit"
                   HeightRequest="80"
                   HorizontalOptions="Center" />

            <Label Text="Confirm your identity"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{toolkit:AppThemeResource BrandForeground}" />

            <Label Text="For security, please re-enter your password to continue."
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   TextColor="{toolkit:AppThemeResource TextMuted}"
                   Margin="0,0,0,10" />

            <Frame Padding="15" CornerRadius="10" HasShadow="False"
                   BackgroundColor="{toolkit:AppThemeResource Surface}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Password" FontSize="14" FontAttributes="Bold" />
                    <Entry x:Name="PasswordEntry"
                           Placeholder="Enter your password"
                           IsPassword="True"
                           IsTextPredictionEnabled="False"
                           ReturnType="Done"
                           Completed="OnPasswordEntryCompleted" />
                </VerticalStackLayout>
            </Frame>

            <Label x:Name="ErrorLabel"
                   TextColor="Red"
                   FontSize="14"
                   HorizontalOptions="Center"
                   IsVisible="False" />

            <Button x:Name="ConfirmButton"
                    Text="Confirm"
                    Clicked="OnConfirmClicked"
                    BackgroundColor="{toolkit:AppThemeResource BrandFill}"
                    TextColor="White"
                    FontSize="18"
                    HeightRequest="50"
                    CornerRadius="25" />

            <!-- Phase 2.5b — visible only when IPasskeyAuthenticator.IsSupported.
                 Sets IsVisible from the code-behind so it stays hidden on
                 iOS < 16 and Android < API 28. -->
            <Button x:Name="PasskeyButton"
                    Text="Use Passkey"
                    Clicked="OnPasskeyClicked"
                    BackgroundColor="Transparent"
                    TextColor="{toolkit:AppThemeResource BrandForeground}"
                    BorderColor="{toolkit:AppThemeResource BrandForeground}"
                    BorderWidth="1"
                    FontSize="16"
                    HeightRequest="50"
                    CornerRadius="25"
                    IsVisible="False" />

            <Button x:Name="CancelButton"
                    Text="Cancel"
                    Clicked="OnCancelClicked"
                    BackgroundColor="Transparent"
                    TextColor="{toolkit:AppThemeResource BrandForeground}"
                    FontSize="16"
                    HeightRequest="40" />

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="{toolkit:AppThemeResource BrandForeground}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
