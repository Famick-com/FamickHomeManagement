<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">


    <!-- ====================================================================
         Semantic theme colours.

         One definition per role, consumed as {toolkit:AppThemeResource Name}.
         Pages previously wrote the light and dark values out at every use site,
         which is how two of them drifted apart: the same role ended up with
         different dark values depending on the file.

         Names describe the role, not the colour. A screen asking for
         "BrandFill" keeps working if the brand changes; one asking for a green
         does not.
         ==================================================================== -->

    <!-- Brand green. Two roles, not one — this is why the same light value has
         two dark counterparts, and it is deliberate:
           foreground lightens on dark so it stays legible against it,
           fill darkens on dark so white text on top still reads. -->
    <toolkit:AppThemeColor x:Key="BrandForeground" Light="#518751" Dark="#7BA17C" />
    <toolkit:AppThemeColor x:Key="BrandFill" Light="#518751" Dark="#3D6B3D" />

    <!-- Two levels, and only two: the page, and anything sitting on it. A card is
         white on a grey page in light and a lighter grey on a black one in dark,
         so it reads as raised in both. Slice 1 had this as #F5F5F5 in light,
         which is the page colour — meaning it was not raised at all until you
         switched to dark. -->
    <toolkit:AppThemeColor x:Key="PageBackground" Light="#F5F5F5" Dark="#121212" />
    <toolkit:AppThemeColor x:Key="Surface" Light="#FFFFFF" Dark="#2A2A2A" />

    <!-- Secondary text and dividers. Both had a second, near-identical dark
         value in a minority of files — genuine drift, resolved to the dominant. -->
    <toolkit:AppThemeColor x:Key="TextMuted" Light="#666666" Dark="#999999" />
    <toolkit:AppThemeColor x:Key="Divider" Light="#E0E0E0" Dark="#424242" />

    <!-- Semantic fills. These keep their meaning — success, warning, information — and are
         never used as accents; that is what stops the palette drifting back into two brands. -->
    <toolkit:AppThemeColor x:Key="SuccessFill" Light="#4CAF50" Dark="#388E3C" />
    <toolkit:AppThemeColor x:Key="WarningSurface" Light="#FFF8E1" Dark="#3E2723" />
    <toolkit:AppThemeColor x:Key="InfoSurface" Light="#E3F2FD" Dark="#1A237E" />
    <toolkit:AppThemeColor x:Key="SuccessSurface" Light="#E8F5E9" Dark="#1B5E20" />
    <toolkit:AppThemeColor x:Key="WarningFill" Light="#FF9800" Dark="#F57C00" />

    <!-- Body text. Softer than pure black, which is harsher than either Material or Apple
         recommend for running text, and the value the style guide already named. The app
         previously spelled this six ways, from Black through #424242. -->
    <toolkit:AppThemeColor x:Key="TextPrimary" Light="#212121" Dark="#EEEEEE" />

    <!-- Destructive actions and error text. -->
    <toolkit:AppThemeColor x:Key="ErrorFill" Light="#D32F2F" Dark="#EF5350" />

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="SystemBackgroundColor">#000000</Color>

    <!-- FamickTheme brand palette. Was the MAUI template purple, which never matched the logo. -->
    <Color x:Key="Primary">#518751</Color>
    <Color x:Key="PrimaryDark">#7BA17C</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#9E9E9E</Color>
    <Color x:Key="SecondaryDarkText">#BDBDBD</Color>
    <Color x:Key="Tertiary">#3D6B3D</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="HouseholdColor">#4CAF50</Color>
    <Color x:Key="BusinessColor">#2196F3</Color>

    <SolidColorBrush x:Key="HouseholdBrush" Color="{StaticResource HouseholdColor}"/>
    <SolidColorBrush x:Key="BusinessBrush" Color="{StaticResource BusinessColor}"/>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>