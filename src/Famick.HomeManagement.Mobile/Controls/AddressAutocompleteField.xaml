<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Famick.HomeManagement.Mobile.Models"
             xmlns:sfInputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             x:Class="Famick.HomeManagement.Mobile.Controls.AddressAutocompleteField">
    <VerticalStackLayout Spacing="8">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalOptions="Center">
            <Entry Grid.Column="0"
                   x:Name="Line1Entry"
                   Placeholder="Address Line 1"
                   TextChanged="OnLine1TextChanged" />
            <ActivityIndicator Grid.Column="1"
                               x:Name="SearchSpinner"
                               IsRunning="False"
                               IsVisible="False"
                               WidthRequest="20"
                               HeightRequest="20"
                               VerticalOptions="Center"
                               Color="{AppThemeBinding Light=#518751, Dark=#7BA17C}" />
        </Grid>

        <CollectionView x:Name="SuggestionsList"
                        IsVisible="False"
                        MaximumHeightRequest="220"
                        SelectionMode="Single"
                        SelectionChanged="OnSuggestionSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:AddressSuggestionDto">
                    <Border Padding="10,8" Margin="0,2"
                            StrokeShape="RoundRectangle 6"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#424242}"
                            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#2A2A2A}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding AddressLine1}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                <Label Text="{Binding DisplayLine}"
                                       FontSize="12" TextColor="Gray"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <!-- Multi-unit badge: visibility is set in code-behind
                                 because MAUI Bindings can't run a >1 comparison
                                 without a converter, and we want to keep this
                                 file converter-free. -->
                            <Border Grid.Column="1"
                                    IsVisible="{Binding HasMultipleUnits}"
                                    Padding="6,2"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#1A237E}"
                                    VerticalOptions="Center">
                                <Label Text="{Binding SecondaryBadge}"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#0D47A1, Dark=White}" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Single-row "no match" prompt — visually mirrors a suggestion row
             so it reads as a dropdown option. Only visible when the provider
             returned zero matches and the user has typed enough to warrant
             offering manual entry. -->
        <Border x:Name="NoMatchPrompt"
                IsVisible="False"
                Padding="10,8" Margin="0,2"
                StrokeShape="RoundRectangle 6"
                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#424242}"
                BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#2A2A2A}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnNoMatchPromptTapped" />
            </Border.GestureRecognizers>
            <Label Text="No match — manually add"
                   FontSize="14"
                   FontAttributes="Italic"
                   TextColor="{AppThemeBinding Light=#518751, Dark=#7BA17C}" />
        </Border>

        <Label x:Name="SelectedIndicator"
               IsVisible="False"
               FontSize="12"
               TextColor="{AppThemeBinding Light=#518751, Dark=#7BA17C}" />

        <!-- Secondary fields — dimmed until either a suggestion is selected
             or the user typed something the provider couldn't match. After
             a selection the canonical fields stay locked (the Addresses
             table is shared/deduped); only Apt/Suite is contact-specific
             and remains editable. -->
        <VerticalStackLayout x:Name="SecondaryFieldsLayout"
                             IsEnabled="False"
                             Opacity="0.55"
                             Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                <sfInputs:SfComboBox Grid.Column="0"
                                     x:Name="Line2Combo"
                                     Placeholder="Apt / Suite (optional)"
                                     IsEditable="True"
                                     IsClearButtonVisible="True"
                                     DisplayMemberPath="AddressLine2"
                                     TextMemberPath="AddressLine2"
                                     SelectionChanged="OnLine2ComboSelectionChanged" />
                <ActivityIndicator Grid.Column="1"
                                   x:Name="ExpandSpinner"
                                   IsRunning="False"
                                   IsVisible="False"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   VerticalOptions="Center"
                                   Color="{AppThemeBinding Light=#518751, Dark=#7BA17C}" />
            </Grid>
            <Entry x:Name="CityEntry"
                   Placeholder="City"
                   TextChanged="OnCityTextChanged" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Entry x:Name="StateEntry" Grid.Column="0"
                       Placeholder="State"
                       TextChanged="OnStateTextChanged" />
                <Entry x:Name="PostalEntry" Grid.Column="1"
                       Placeholder="ZIP"
                       TextChanged="OnPostalTextChanged" />
            </Grid>
            <Entry x:Name="CountryEntry"
                   Placeholder="Country"
                   TextChanged="OnCountryTextChanged" />
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentView>
