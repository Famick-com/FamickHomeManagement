{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=famick_homemanagement;Username=postgres;Password=postgres"
  },
  "FixedTenantId": "00000000-0000-0000-0000-000000000001",
  "FeatureManagement": {
    "step_up_enabled": false,
    "check_endpoint_enabled": false,
    "two_step_login_v2": false,
    "use_auth_famick_com": false,
    "proxy_signup_enabled": false,
    "proxy_agent_enabled": false,
    "proxy_tunnel_enabled": false
  },
  "JwtSettings": {
    "SecretKey": "your-256-bit-secret-key-CHANGE-THIS-IN-PRODUCTION-min-32-chars",
    "RsaPrivateKeyPem": "",
    "Issuer": "Famick.HomeManagement",
    "Audience": "Famick.HomeManagement.Api",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7,
    "RefreshTokenExtendedExpirationDays": 30,
    "StepUpFreshnessSeconds": 300
  },
  "EmailSettings": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "EnableSsl": true,
    "FromEmail": "",
    "FromName": "Famick Home Management",
    "PasswordResetTokenExpirationMinutes": 15
  },
  "Geoapify": {
    "ApiKey": "",
    "BaseUrl": "https://api.geoapify.com/v1/geocode"
  },
  "AddressCanonicalizer": {
    "Provider": "None"
  },
  "Libpostal": {
    "BaseUrl": "http://libpostal:8080",
    "TimeoutSeconds": 5
  },
  "ExternalAuth": {
    "Apple": {
      "Enabled": false,
      "ClientId": "",
      "TeamId": "",
      "KeyId": "",
      "PrivateKey": ""
    },
    "Google": {
      "Enabled": false,
      "ClientId": "",
      "ClientSecret": ""
    },
    "OpenIdConnect": {
      "Enabled": false,
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "DisplayName": "SSO"
    },
    "Passkey": {
      "Enabled": true,
      "RelyingPartyId": "localhost",
      "RelyingPartyName": "Famick Home Management",
      "Origins": ["https://localhost:5001", "http://localhost:5000"],
      "RequireUserVerification": true
    }
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "*",
        "Period": "1h",
        "Limit": 1000
      }
    ],
    "EndpointWhitelist": [
      "get:/health",
      "post:/api/auth/refresh"
    ],
    "ClientWhitelist": []
  },
  "IpRateLimitPolicies": {
    "IpRules": [
      {
        "Ip": "*",
        "Rules": [
          {
            "Endpoint": "*/api/auth/*",
            "Period": "1m",
            "Limit": 15
          },
          {
            "Endpoint": "*/api/auth/*",
            "Period": "1h",
            "Limit": 60
          }
        ]
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RedirectUriAllowList": {
    "Hosts": [ "localhost" ]
  },
