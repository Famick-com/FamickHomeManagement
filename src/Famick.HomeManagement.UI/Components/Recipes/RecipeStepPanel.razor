@inject IApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILocalizer L
@using Famick.HomeManagement.Core.DTOs.Recipes
@using Famick.HomeManagement.Core.DTOs.Products
@using Famick.HomeManagement.Core.DTOs.QuantityUnits
@using Famick.HomeManagement.Core.Helpers

<MudStack Spacing="3">
    @* Step fields *@
    <MudTextField @bind-Value="_title" @bind-Value:after="ReportDirtyAsync"
                  Label="@L["recipes.steps.stepTitle"]"
                  HelperText="@L["recipes.steps.stepTitleHelp"]"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  ReadOnly="@(!CanEdit || _isSaving)" />

    <MudTextField @bind-Value="_description" @bind-Value:after="ReportDirtyAsync"
                  Label="@L["recipes.steps.description"]"
                  HelperText="@L["recipes.steps.descriptionHelp"]"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Lines="2"
                  ReadOnly="@(!CanEdit || _isSaving)" />

    <MudTextField @bind-Value="_instructions" @bind-Value:after="ReportDirtyAsync"
                  Label="@L["recipes.steps.instructions"]"
                  Variant="Variant.Outlined"
                  Lines="4"
                  ReadOnly="@(!CanEdit || _isSaving)" />

    @if (CanEdit)
    {
        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                   OnClick="@(() => SaveStepAsync())" Disabled="_isSaving"
                   StartIcon="@Icons.Material.Filled.Save">
            @L["common.save"]
        </MudButton>
    }

    @* Media *@
    <RecipeStepMedia RecipeId="RecipeId" Step="Step" CanEdit="@CanEdit" OnMediaChanged="OnStepChanged" />

    @* Ingredients *@
    <MudDivider Class="my-2" />
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.subtitle1">@L["recipes.ingredients.title"]</MudText>
        @if (CanEdit)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => { _showAddIngredient = !_showAddIngredient; _editing = null; })">
                @L["recipes.ingredients.add"]
            </MudButton>
        }
    </MudStack>

    @if (_showAddIngredient && CanEdit)
    {
        <MudPaper Elevation="0" Class="pa-3" Style="background: var(--mud-palette-background-grey);">
            <MudStack Spacing="2">
                <RecipeIngredientAutocomplete @bind-SelectedProduct="_newIngredientProduct" CanEdit="true" />
                <MudGrid>
                    <MudItem xs="6" sm="4">
                        <MudNumericField T="decimal" @bind-Value="_newIngredientAmount"
                                         Label="@L["recipes.ingredients.amount"]"
                                         Min="0.01M" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudSelect T="Guid?" @bind-Value="_newIngredientUnitId"
                                   Label="@L["recipes.ingredients.unit"]"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                            @foreach (var unit in _quantityUnits)
                            {
                                <MudSelectItem T="Guid?" Value="@unit.Id">@unit.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_newIngredientGroup"
                                      Label="@L["recipes.ingredients.group"]"
                                      HelperText="@L["recipes.ingredients.groupHelp"]"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>
                <MudTextField @bind-Value="_newIngredientNote"
                              Label="@L["recipes.ingredients.note"]"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           OnClick="AddIngredientAsync"
                           Disabled="@(_newIngredientProduct == null || _newIngredientAmount <= 0 || _isSaving)">
                    @L["common.add"]
                </MudButton>
            </MudStack>
        </MudPaper>
    }

    @if (_editing != null && CanEdit)
    {
        <MudPaper Elevation="0" Class="pa-3" Style="background: var(--mud-palette-background-grey);">
            <MudStack Spacing="2">
                @if (!string.IsNullOrEmpty(_editing.OriginalText))
                {
                    <MudText Typo="Typo.body2">
                        @(_editing.ProductId is null
                            ? L["recipes.ingredients.linking", _editing.OriginalText]
                            : L["recipes.ingredients.importedAs", _editing.OriginalText])
                    </MudText>
                }
                <RecipeIngredientAutocomplete @bind-SelectedProduct="_editProduct" CanEdit="true" />
                <MudGrid>
                    <MudItem xs="6" sm="4">
                        <MudNumericField T="decimal" @bind-Value="_editAmount"
                                         Label="@L["recipes.ingredients.amount"]"
                                         Min="0.01M" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudSelect T="Guid?" @bind-Value="_editUnitId"
                                   Label="@L["recipes.ingredients.unit"]"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                            @foreach (var unit in _quantityUnits)
                            {
                                <MudSelectItem T="Guid?" Value="@unit.Id">@unit.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_editGroup"
                                      Label="@L["recipes.ingredients.group"]"
                                      HelperText="@L["recipes.ingredients.groupHelp"]"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>
                <MudTextField @bind-Value="_editNote"
                              Label="@L["recipes.ingredients.note"]"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               OnClick="SaveEditAsync"
                               Disabled="@(_editProduct == null || _editAmount <= 0 || _isSaving)">
                        @(_editing.ProductId is null ? L["recipes.ingredients.link"] : L["common.save"])
                    </MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _editing = null)">
                        @L["common.cancel"]
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    }

    @if (Step.Ingredients.Any())
    {
        <MudTable T="RecipeIngredientDto" Items="@Step.Ingredients.OrderBy(i => i.SortOrder)" Dense="true" Elevation="0">
            <HeaderContent>
                <MudTh>@L["recipes.ingredients.product"]</MudTh>
                <MudTh>@L["recipes.ingredients.amount"]</MudTh>
                <MudTh>@L["recipes.ingredients.unit"]</MudTh>
                <MudTh>@L["recipes.ingredients.note"]</MudTh>
                @if (CanEdit)
                {
                    <MudTh Style="width: 96px;"></MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                @if (context.ProductId is null)
                {
                    <MudTd colspan="4">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.body2">@context.OriginalText</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                                @L["recipes.ingredients.notLinked"]
                            </MudChip>
                            @if (CanEdit)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Link"
                                           OnClick="@(() => StartEditing(context))">
                                    @L["recipes.ingredients.linkProduct"]
                                </MudButton>
                            }
                        </MudStack>
                    </MudTd>
                }
                else
                {
                    <MudTd>@context.ProductName</MudTd>
                    <MudTd>@context.Amount</MudTd>
                    <MudTd>@context.QuantityUnitName</MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body2">@context.Note</MudText>
                        @if (!string.IsNullOrEmpty(context.IngredientGroup))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.IngredientGroup</MudText>
                        }
                    </MudTd>
                }
                @if (CanEdit)
                {
                    <MudTd Style="white-space: nowrap;">
                        @if (context.ProductId is not null)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           aria-label="@L["common.edit"]"
                                           OnClick="@(() => StartEditing(context))" />
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       aria-label="@L["common.delete"]"
                                       OnClick="@(() => DeleteIngredientAsync(context))" />
                    </MudTd>
                }
            </RowTemplate>
        </MudTable>
    }
    else
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["recipes.ingredients.noIngredients"]</MudText>
    }
</MudStack>

@code {
    [Parameter] public Guid RecipeId { get; set; }
    [Parameter] public RecipeStepDto Step { get; set; } = null!;
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback OnStepChanged { get; set; }

    /// <summary>Raised when the step gains or loses unsaved changes to its title, description or instructions.</summary>
    [Parameter] public EventCallback<bool> OnDirtyChanged { get; set; }

    // One save at a time per step, so an older save can't finish last and overwrite newer text. The
    // fields are read-only while a save is out, so nothing typed can go unnoticed beside it; leaving the
    // page during one sees the step as unsaved and waits its turn.
    private readonly SemaphoreSlim _saveLock = new(1, 1);
    private int _savesInFlight;
    private bool _isSaving => _savesInFlight > 0;
    private bool _showAddIngredient;
    private string _title = string.Empty;
    private string _description = string.Empty;
    private string _instructions = string.Empty;

    // The step's fields as last loaded or saved. The page reloads every step after any change to the
    // recipe (a save, an ingredient, media, a reorder), so a field that differs from these is unsaved
    // typing, and is kept rather than overwritten.
    private string _savedTitle = string.Empty;
    private string _savedDescription = string.Empty;
    private string _savedInstructions = string.Empty;

    private bool IsDirty =>
        _title != _savedTitle || _description != _savedDescription || _instructions != _savedInstructions;

    private bool _reportedDirty;

    private async Task ReportDirtyAsync()
    {
        if (IsDirty == _reportedDirty)
            return;

        _reportedDirty = IsDirty;
        await OnDirtyChanged.InvokeAsync(_reportedDirty);
    }

    /// <summary>
    /// Saves what has been typed, if anything, without reloading the recipe: for leaving the page.
    /// </summary>
    /// <returns>Whether nothing is left unsaved.</returns>
    public Task<bool> SaveUnsavedAsync() =>
        IsDirty ? SaveStepAsync(quiet: true, refresh: false) : Task.FromResult(true);

    private ProductDto? _newIngredientProduct;
    private decimal _newIngredientAmount = 1;
    private Guid? _newIngredientUnitId;
    private string _newIngredientNote = string.Empty;
    private string _newIngredientGroup = string.Empty;
    private List<QuantityUnitDto> _quantityUnits = new();

    protected override void OnParametersSet()
    {
        var dirty = IsDirty;
        _savedTitle = Step.Title ?? string.Empty;
        _savedDescription = Step.Description ?? string.Empty;
        _savedInstructions = Step.Instructions ?? string.Empty;
        if (dirty)
            return;

        _title = _savedTitle;
        _description = _savedDescription;
        _instructions = _savedInstructions;
    }

    protected override async Task OnInitializedAsync()
    {
        var result = await ApiClient.GetAsync<List<QuantityUnitDto>>("api/v1/quantity-units");
        if (result.IsSuccess && result.Data != null)
        {
            _quantityUnits = result.Data;
        }
    }

    /// <param name="refresh">Whether to reload the recipe afterwards.</param>
    /// <returns>Whether the step was saved.</returns>
    private async Task<bool> SaveStepAsync(bool quiet = false, bool refresh = true)
    {
        _savesInFlight++;
        await _saveLock.WaitAsync();
        try
        {
            // What is sent: anything typed while the request is out is not saved, and stays unsaved.
            var title = _title;
            var description = _description;
            var instructions = _instructions;

            var request = new UpdateRecipeStepRequest
            {
                Title = string.IsNullOrWhiteSpace(title) ? null : title.Trim(),
                Description = string.IsNullOrWhiteSpace(description) ? null : description.Trim(),
                Instructions = instructions.Trim(),
                VideoUrl = Step.VideoUrl
            };

            var result = await ApiClient.PutAsync<UpdateRecipeStepRequest, RecipeStepDto>(
                $"api/v1/recipes/{RecipeId}/steps/{Step.Id}", request);

            if (!result.IsSuccess)
            {
                Snackbar.Add(result.ErrorMessage ?? L["common.error"], Severity.Error);
                return false;
            }

            // What was saved is now the step's own text, so a reload takes it from the server again.
            _savedTitle = title;
            _savedDescription = description;
            _savedInstructions = instructions;
            await ReportDirtyAsync();

            if (!quiet)
                Snackbar.Add(L["recipes.steps.saved"], Severity.Success);
            if (refresh)
                await OnStepChanged.InvokeAsync();
            return true;
        }
        finally
        {
            _saveLock.Release();
            _savesInFlight--;
        }
    }

    private async Task AddIngredientAsync()
    {
        if (_newIngredientProduct == null || _newIngredientAmount <= 0) return;

        // Save what has been typed first: adding the ingredient reloads the step. If that fails, the
        // error shows and the ingredient waits, rather than be added to a step that didn't save.
        if (IsDirty && !await SaveStepAsync(quiet: true))
            return;

        var request = new CreateRecipeIngredientRequest
        {
            ProductId = _newIngredientProduct.Id,
            Amount = _newIngredientAmount,
            QuantityUnitId = _newIngredientUnitId,
            Note = string.IsNullOrWhiteSpace(_newIngredientNote) ? null : _newIngredientNote.Trim(),
            IngredientGroup = string.IsNullOrWhiteSpace(_newIngredientGroup) ? null : _newIngredientGroup.Trim(),
            SortOrder = Step.Ingredients.Count
        };

        var result = await ApiClient.PostAsync<CreateRecipeIngredientRequest, RecipeIngredientDto>(
            $"api/v1/recipes/{RecipeId}/steps/{Step.Id}/ingredients", request);

        if (result.IsSuccess)
        {
            Snackbar.Add(L["recipes.ingredients.saved"], Severity.Success);
            _newIngredientProduct = null;
            _newIngredientAmount = 1;
            _newIngredientUnitId = null;
            _newIngredientNote = string.Empty;
            _newIngredientGroup = string.Empty;
            _showAddIngredient = false;
            await OnStepChanged.InvokeAsync();
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? L["common.error"], Severity.Error);
        }
    }

    // The line being edited. An unlinked line is being linked to a product, with what its text says prefilled.
    private RecipeIngredientDto? _editing;
    private ProductDto? _editProduct;
    private decimal _editAmount = 1;
    private Guid? _editUnitId;
    private string _editNote = string.Empty;
    private string _editGroup = string.Empty;

    private void StartEditing(RecipeIngredientDto ingredient)
    {
        _editing = ingredient;
        _editGroup = ingredient.IngredientGroup ?? string.Empty;
        _showAddIngredient = false;

        if (ingredient.ProductId is { } productId)
        {
            _editProduct = new ProductDto { Id = productId, Name = ingredient.ProductName };
            _editAmount = ingredient.Amount;
            _editUnitId = ingredient.QuantityUnitId;
            _editNote = ingredient.Note ?? string.Empty;
            return;
        }

        var parsed = IngredientLineParser.Parse(ingredient.OriginalText);
        _editProduct = null;
        _editAmount = parsed.Amount ?? 1;
        _editUnitId = UnitFor(parsed);
        _editNote = ingredient.Note ?? parsed.Note ?? string.Empty;
    }

    /// <summary>The household unit for the line's unit, as the importer picks it: by standard measure, then by name.</summary>
    private Guid? UnitFor(ParsedIngredientLine parsed)
    {
        if (parsed.StandardUnit is { } standard && _quantityUnits.FirstOrDefault(u => u.StandardUnit == standard) is { } tagged)
            return tagged.Id;

        if (parsed.Unit is not { } written)
            return null;

        var forms = IngredientLineParser.NameForms(written);
        return _quantityUnits.FirstOrDefault(u =>
            forms.Contains(u.Name.ToLowerInvariant()) || forms.Contains(u.NamePlural.ToLowerInvariant()))?.Id;
    }

    private async Task SaveEditAsync()
    {
        if (_editing == null || _editProduct == null || _editAmount <= 0) return;

        // Save what has been typed first: saving the line reloads the step.
        if (IsDirty && !await SaveStepAsync(quiet: true))
            return;

        var linking = _editing.ProductId is null;
        var request = new UpdateRecipeIngredientRequest
        {
            ProductId = _editProduct.Id,
            Amount = _editAmount,
            AmountInGrams = _editing.AmountInGrams,
            QuantityUnitId = _editUnitId,
            Note = string.IsNullOrWhiteSpace(_editNote) ? null : _editNote.Trim(),
            IngredientGroup = string.IsNullOrWhiteSpace(_editGroup) ? null : _editGroup.Trim(),
            OnlyCheckSingleUnitInStock = _editing.OnlyCheckSingleUnitInStock,
            NotCheckStockFulfillment = _editing.NotCheckStockFulfillment,
            SortOrder = _editing.SortOrder
        };

        var result = await ApiClient.PutAsync<UpdateRecipeIngredientRequest, RecipeIngredientDto>(
            $"api/v1/recipes/{RecipeId}/steps/{Step.Id}/ingredients/{_editing.Id}", request);

        if (result.IsSuccess)
        {
            Snackbar.Add(linking ? L["recipes.ingredients.linked"] : L["recipes.ingredients.saved"], Severity.Success);
            _editing = null;
            _editProduct = null;
            await OnStepChanged.InvokeAsync();
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? L["common.error"], Severity.Error);
        }
    }

    private async Task DeleteIngredientAsync(RecipeIngredientDto ingredient)
    {
        var result = await ApiClient.DeleteAsync(
            $"api/v1/recipes/{RecipeId}/steps/{Step.Id}/ingredients/{ingredient.Id}");

        if (result.IsSuccess)
        {
            Snackbar.Add(L["recipes.ingredients.deleted"], Severity.Success);
            await OnStepChanged.InvokeAsync();
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? L["common.error"], Severity.Error);
        }
    }
}
