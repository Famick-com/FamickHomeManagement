@using Famick.HomeManagement.Core.DTOs.Products
@using Famick.HomeManagement.Core.DTOs.ProductLookup
@using Famick.HomeManagement.Core.DTOs.Locations
@using Famick.HomeManagement.Core.DTOs.QuantityUnits
@using Famick.HomeManagement.UI.Components.Products
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject ILocalizer L

@*
    Recipe ingredient product picker. Bound single-select over the shared UnifiedProductSearch
    (General context = local + master catalog). Resolves the chosen result to a tenant ProductDto,
    materializing master-catalog products and creating brand-new ones on demand.
*@

<UnifiedProductSearch Context="ProductSearchContext.General"
                      Label="@L["recipes.ingredients.searchProducts"]"
                      Disabled="@(!CanEdit)"
                      ClearOnSelect="false"
                      SelectedText="@SelectedProduct?.Name"
                      AllowAddProduct="@CanCreate"
                      AddProductLabel="@L["recipes.ingredients.createProduct"]"
                      OnSelect="HandleSelect"
                      OnAddProduct="HandleAdd" />

@code {
    [Parameter] public ProductDto? SelectedProduct { get; set; }
    [Parameter] public EventCallback<ProductDto?> SelectedProductChanged { get; set; }
    [Parameter] public bool CanEdit { get; set; } = true;

    private Guid? _defaultLocationId;
    private Guid? _defaultQuantityUnitId;

    private bool CanCreate => CanEdit && _defaultLocationId.HasValue && _defaultQuantityUnitId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        var locationsTask = ApiClient.GetAsync<List<LocationDto>>("api/v1/locations");
        var unitsTask = ApiClient.GetAsync<List<QuantityUnitDto>>("api/v1/quantity-units");

        await Task.WhenAll(locationsTask, unitsTask);

        var locationsResult = await locationsTask;
        if (locationsResult.IsSuccess && locationsResult.Data?.Count > 0)
            _defaultLocationId = locationsResult.Data[0].Id;

        var unitsResult = await unitsTask;
        if (unitsResult.IsSuccess && unitsResult.Data?.Count > 0)
            _defaultQuantityUnitId = unitsResult.Data[0].Id;
    }

    private async Task HandleSelect(ProductLookupResultDto result)
    {
        ProductDto? product = null;

        if (result.LocalProductId.HasValue)
        {
            var existing = await ApiClient.GetAsync<ProductDto>($"api/v1/products/{result.LocalProductId.Value}");
            if (existing.IsSuccess) product = existing.Data;
        }
        else if (result.MasterProductId.HasValue)
        {
            var fromMaster = await ApiClient.PostAsync<object, ProductDto>(
                $"api/v1/products/from-master/{result.MasterProductId.Value}", new { });
            if (fromMaster.IsSuccess) product = fromMaster.Data;
            else Snackbar.Add(fromMaster.ErrorMessage ?? L["common.error"], Severity.Error);
        }

        if (product != null)
        {
            SelectedProduct = product;
            await SelectedProductChanged.InvokeAsync(product);
        }
    }

    private async Task HandleAdd(string name)
    {
        var product = await CreateProductAsync(name);
        if (product != null)
        {
            SelectedProduct = product;
            await SelectedProductChanged.InvokeAsync(product);
        }
    }

    private async Task<ProductDto?> CreateProductAsync(string name)
    {
        if (!_defaultLocationId.HasValue || !_defaultQuantityUnitId.HasValue)
        {
            Snackbar.Add(L["common.error"], Severity.Warning);
            return null;
        }

        var request = new CreateProductRequest
        {
            Name = name,
            LocationId = _defaultLocationId.Value,
            QuantityUnitIdStock = _defaultQuantityUnitId.Value,
            QuantityUnitIdPurchase = _defaultQuantityUnitId.Value,
            QuantityUnitFactorPurchaseToStock = 1.0m,
            MinStockAmount = 0,
            DefaultBestBeforeDays = 0,
            IsActive = true
        };

        var result = await ApiClient.PostAsync<CreateProductRequest, ProductDto>("api/v1/products", request);

        if (result.IsSuccess && result.Data != null)
        {
            Snackbar.Add(L["recipes.ingredients.productCreated", name], Severity.Success);
            return result.Data;
        }

        Snackbar.Add(result.ErrorMessage ?? L["common.error"], Severity.Error);
        return null;
    }
}
