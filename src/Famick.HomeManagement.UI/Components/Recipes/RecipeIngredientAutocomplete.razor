@using Famick.HomeManagement.Core.DTOs.Products
@using Famick.HomeManagement.Core.DTOs.Locations
@using Famick.HomeManagement.Core.DTOs.QuantityUnits
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject ILocalizer L

<MudAutocomplete T="ProductDto" @ref="_autocomplete"
                 Label="@L["recipes.ingredients.searchProducts"]"
                 Variant="Variant.Outlined"
                 Margin="Margin.Dense"
                 SearchFunc="SearchProductsAsync"
                 ToStringFunc="@(p => p?.Name ?? "")"
                 Value="@SelectedProduct"
                 ValueChanged="HandleValueChanged"
                 Clearable="true"
                 ShowProgressIndicator="true"
                 DebounceInterval="300"
                 Disabled="@(!CanEdit)"
                 CoerceText="false"
                 CoerceValue="false"
                 ResetValueOnEmptyText="true">
    <ItemTemplate Context="product">
        @if (product.Id == Guid.Empty)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Size="Size.Small" />
                <MudText Color="Color.Primary">@L["recipes.ingredients.createProduct"]: "@product.Name"</MudText>
            </MudStack>
        }
        else
        {
            <MudStack Spacing="0" Class="flex-grow-1">
                @if (_groupHeaders.TryGetValue(product.Id, out var header))
                {
                    <MudText Typo="Typo.overline" Color="Color.Secondary">@header</MudText>
                }
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Spacing="0">
                        <MudText>@product.Name</MudText>
                        @if (_catalog.Contains(product.Id))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["recipes.ingredients.fromCatalog"]</MudText>
                        }
                        else if (!string.IsNullOrEmpty(product.ProductGroupName))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@product.ProductGroupName</MudText>
                        }
                    </MudStack>
                </MudStack>
            </MudStack>
        }
    </ItemTemplate>
    <NoItemsTemplate>
        <MudText Typo="Typo.body2" Class="pa-2">@L["common.noResults"]</MudText>
    </NoItemsTemplate>
</MudAutocomplete>

@code {
    [Parameter] public ProductDto? SelectedProduct { get; set; }
    [Parameter] public EventCallback<ProductDto?> SelectedProductChanged { get; set; }
    [Parameter] public bool CanEdit { get; set; } = true;

    private Guid? _defaultLocationId;
    private Guid? _defaultQuantityUnitId;

    // The first product of each group, labelled with that group's header.
    private readonly Dictionary<Guid, string> _groupHeaders = new();

    private MudAutocomplete<ProductDto> _autocomplete = null!;

    // After a catalog product couldn't be added: the box goes back to this (or is cleared) once it has
    // drawn the pick. The restore's own callback doesn't go through HandleValueChanged again; anything
    // the user picks meanwhile still does.
    private bool _restoreAfterRender;
    private ProductDto? _restoreTo;
    private bool _restoring;

    // Catalog products in the results, by their catalog id. Picking one adds it to the household.
    private readonly HashSet<Guid> _catalog = new();

    protected override async Task OnInitializedAsync()
    {
        var locationsTask = ApiClient.GetAsync<List<LocationDto>>("api/v1/locations");
        var unitsTask = ApiClient.GetAsync<List<QuantityUnitDto>>("api/v1/quantity-units");

        await Task.WhenAll(locationsTask, unitsTask);

        var locationsResult = await locationsTask;
        if (locationsResult.IsSuccess && locationsResult.Data?.Count > 0)
            _defaultLocationId = locationsResult.Data[0].Id;

        var unitsResult = await unitsTask;
        if (unitsResult.IsSuccess && unitsResult.Data?.Count > 0)
            _defaultQuantityUnitId = unitsResult.Data[0].Id;
    }

    private async Task<IEnumerable<ProductDto>> SearchProductsAsync(string searchText, CancellationToken cancellationToken)
    {
        var queryParams = new List<string> { "isActive=true", "genericFirst=true" };

        if (!string.IsNullOrWhiteSpace(searchText))
            queryParams.Add($"searchTerm={Uri.EscapeDataString(searchText)}");

        var queryString = string.Join("&", queryParams);
        var result = await ApiClient.GetAsync<List<ProductDto>>($"api/v1/products?{queryString}");
        var products = result.IsSuccess && result.Data != null
            ? result.Data.Take(30).ToList()
            : new List<ProductDto>();

        // The search adds the catalog's products the household doesn't have, with no id of their own.
        // They're keyed here by their catalog id, which picking one adds to the household.
        _catalog.Clear();
        foreach (var product in products.Where(p => p is { IsCatalogProduct: true, MasterProductId: not null }))
        {
            product.Id = product.MasterProductId!.Value;
            _catalog.Add(product.Id);
        }

        // The server orders generic products first. Headers only when there is more than one group.
        _groupHeaders.Clear();
        var firstGeneric = products.FirstOrDefault(p => p.IsGeneric);
        var firstSpecific = products.FirstOrDefault(p => !p.IsGeneric);
        if (firstGeneric != null && firstSpecific != null)
        {
            _groupHeaders[firstGeneric.Id] = L["recipes.ingredients.genericGroup"];
            _groupHeaders[firstSpecific.Id] = L["recipes.ingredients.specificGroup"];
        }

        if (!string.IsNullOrWhiteSpace(searchText) &&
            CanEdit &&
            _defaultLocationId.HasValue &&
            _defaultQuantityUnitId.HasValue)
        {
            var exactMatch = products.Any(p => p.Name.Equals(searchText, StringComparison.OrdinalIgnoreCase));
            if (!exactMatch)
            {
                products.Insert(0, new ProductDto
                {
                    Id = Guid.Empty,
                    Name = searchText.Trim()
                });
            }
        }

        return products;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_restoreAfterRender)
            return;

        _restoreAfterRender = false;
        _restoring = true;
        try
        {
            if (_restoreTo != null)
                await _autocomplete.SelectOptionAsync(_restoreTo);
            else
                await _autocomplete.ClearAsync();
        }
        finally
        {
            _restoring = false;
        }
    }

    private async Task HandleValueChanged(ProductDto? value)
    {
        // Putting the box back as it was: the selection itself hasn't changed.
        if (_restoring && ReferenceEquals(value, _restoreTo))
            return;

        // A catalog product becomes the household's first, as when adding one to a shopping list.
        if (value != null && _catalog.Contains(value.Id))
        {
            var adopted = await ApiClient.PostAsync<object, ProductDto>($"api/v1/products/from-master/{value.Id}", new { });
            if (adopted.IsSuccess && adopted.Data != null)
            {
                Snackbar.Add(L["recipes.ingredients.addedFromCatalog", adopted.Data.Name], Severity.Success);
                SelectedProduct = adopted.Data;
                await SelectedProductChanged.InvokeAsync(adopted.Data);
            }
            else
            {
                Snackbar.Add(adopted.ErrorMessage ?? L["common.error"], Severity.Error);

                // The box shows the catalog product once this returns. Put back what was chosen before,
                // or clear it, after it has drawn that.
                _restoreTo = SelectedProduct;
                _restoreAfterRender = true;
                StateHasChanged();
            }
            return;
        }

        if (value != null && value.Id == Guid.Empty)
        {
            var newProduct = await CreateProductAsync(value.Name);
            if (newProduct != null)
            {
                SelectedProduct = newProduct;
                await SelectedProductChanged.InvokeAsync(newProduct);
            }
            return;
        }

        SelectedProduct = value;
        await SelectedProductChanged.InvokeAsync(value);
    }

    private async Task<ProductDto?> CreateProductAsync(string name)
    {
        if (!_defaultLocationId.HasValue || !_defaultQuantityUnitId.HasValue)
        {
            Snackbar.Add(L["common.error"], Severity.Warning);
            return null;
        }

        var request = new CreateProductRequest
        {
            Name = name,
            LocationId = _defaultLocationId.Value,
            QuantityUnitIdStock = _defaultQuantityUnitId.Value,
            QuantityUnitIdPurchase = _defaultQuantityUnitId.Value,
            QuantityUnitFactorPurchaseToStock = 1.0m,
            MinStockAmount = 0,
            DefaultBestBeforeDays = 0,
            IsActive = true
        };

        var result = await ApiClient.PostAsync<CreateProductRequest, ProductDto>("api/v1/products", request);

        if (result.IsSuccess && result.Data != null)
        {
            Snackbar.Add(L["recipes.ingredients.productCreated", name], Severity.Success);
            return result.Data;
        }

        Snackbar.Add(result.ErrorMessage ?? L["common.error"], Severity.Error);
        return null;
    }
}
