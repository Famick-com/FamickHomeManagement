@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject ILocalizer L
@inject IDialogService DialogService
@using Famick.HomeManagement.Core.DTOs.AuthProxy

<MudPaper Elevation="1" Class="pa-4">
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_status is not null)
    {
        @* Paired state *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
            <MudText Typo="Typo.subtitle1">@L["settings.authProxyPairing.pairedTo"] @_status.DisplayName</MudText>
        </MudStack>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            @L["settings.authProxyPairing.host"]: @_status.AuthProxyBaseUrl
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            @L["settings.authProxyPairing.homeServerId"]: <code>@_status.AuthProxyHomeServerId</code>
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            @L["settings.authProxyPairing.pairedBy"]: @_status.PairedAdminEmail @($"({_status.PairedAt:yyyy-MM-dd HH:mm} UTC)")
        </MudText>

        @* Subscription block — driven by AuthProxy's /pairing/status/{id}.
           SubscriptionStatus is null when AuthProxy was unreachable; we
           render the pairing info either way so this section can't break
           the page. *@
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["settings.authProxyPairing.subscription.title"]</MudText>

        @if (_status.SubscriptionStatus == "trial")
        {
            var daysRemaining = ComputeDaysRemaining(_status.TrialEndsAt);
            <MudAlert Severity="Severity.Info" Class="mb-2" NoIcon="false">
                @string.Format(L["settings.authProxyPairing.subscription.trialActive"], daysRemaining, _status.TrialEndsAt?.ToString("yyyy-MM-dd"))
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Href="@_status.BillingUrl" Target="_blank"
                       StartIcon="@Icons.Material.Filled.OpenInNew"
                       Class="mr-2">
                @L["settings.authProxyPairing.subscription.signUp"]
            </MudButton>
        }
        else if (_status.SubscriptionStatus == "active")
        {
            <MudAlert Severity="Severity.Success" Class="mb-2" NoIcon="false">
                @string.Format(L["settings.authProxyPairing.subscription.active"], _status.CurrentPeriodEndsAt?.ToString("yyyy-MM-dd"))
            </MudAlert>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       Href="@_status.BillingUrl" Target="_blank"
                       StartIcon="@Icons.Material.Filled.OpenInNew"
                       Class="mr-2">
                @L["settings.authProxyPairing.subscription.manage"]
            </MudButton>
        }
        else if (_status.SubscriptionStatus == "pastdue")
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2" NoIcon="false">
                @L["settings.authProxyPairing.subscription.pastDue"]
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Warning"
                       Href="@_status.BillingUrl" Target="_blank"
                       StartIcon="@Icons.Material.Filled.OpenInNew"
                       Class="mr-2">
                @L["settings.authProxyPairing.subscription.updatePayment"]
            </MudButton>
        }
        else if (_status.SubscriptionStatus == "pastduegraceexpired" || _status.SubscriptionStatus == "canceled")
        {
            <MudAlert Severity="Severity.Error" Class="mb-2" NoIcon="false">
                @L["settings.authProxyPairing.subscription.expired"]
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Href="@_status.BillingUrl" Target="_blank"
                       StartIcon="@Icons.Material.Filled.OpenInNew"
                       Class="mr-2">
                @L["settings.authProxyPairing.subscription.resubscribe"]
            </MudButton>
        }
        else if (_status.SubscriptionStatus == "comped")
        {
            <MudAlert Severity="Severity.Info" Class="mb-2" NoIcon="false">
                @L["settings.authProxyPairing.subscription.comped"]
            </MudAlert>
        }
        else
        {
            @* SubscriptionStatus null (AuthProxy unreachable) or an
               unrecognized value — degrade gracefully. *@
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                @L["settings.authProxyPairing.subscription.unavailable"]
            </MudText>
        }

        <MudDivider Class="my-3" />
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.LinkOff"
                   OnClick="ConfirmUnpair">
            @L["settings.authProxyPairing.unpair"]
        </MudButton>
    }
    else
    {
        @* Unpaired state *@
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            @L["settings.authProxyPairing.unpairedHelp"]
        </MudText>
        <MudStack Spacing="2">
            <MudTextField @bind-Value="_token"
                          Label="@L["settings.authProxyPairing.token"]"
                          Variant="Variant.Outlined"
                          Placeholder="@L["settings.authProxyPairing.tokenPlaceholder"]"
                          HelperText="@L["settings.authProxyPairing.tokenHelp"]"
                          Disabled="@_isSubmitting" />
            <MudTextField @bind-Value="_displayName"
                          Label="@L["settings.authProxyPairing.displayName"]"
                          Variant="Variant.Outlined"
                          Placeholder="@L["settings.authProxyPairing.displayNamePlaceholder"]"
                          Disabled="@_isSubmitting" />
            <MudTextField @bind-Value="_publicUrl"
                          Label="@L["settings.authProxyPairing.publicUrl"]"
                          Variant="Variant.Outlined"
                          Placeholder="@L["settings.authProxyPairing.publicUrlPlaceholder"]"
                          HelperText="@L["settings.authProxyPairing.publicUrlHelp"]"
                          Disabled="@_isSubmitting" />
            <MudStack Row="true" Justify="Justify.FlexEnd">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Link"
                           OnClick="CompletePairing"
                           Disabled="@(_isSubmitting || string.IsNullOrWhiteSpace(_token) || string.IsNullOrWhiteSpace(_displayName))">
                    @L["settings.authProxyPairing.complete"]
                </MudButton>
            </MudStack>
        </MudStack>
    }
</MudPaper>

@code {
    private bool _isLoading = true;
    private bool _isSubmitting;
    private PairingStatusResponse? _status;

    private string _token = string.Empty;
    private string _displayName = string.Empty;
    private string _publicUrl = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadStatusAsync();
    }

    private async Task LoadStatusAsync()
    {
        _isLoading = true;
        var result = await ApiClient.GetAsync<PairingStatusResponse>("api/auth-proxy/pairing/status");
        // Endpoint always returns 200 with IsPaired set — branch on the flag,
        // not on null Data.
        _status = result.IsSuccess && result.Data?.IsPaired == true ? result.Data : null;
        _isLoading = false;
    }

    private async Task CompletePairing()
    {
        if (string.IsNullOrWhiteSpace(_token) || string.IsNullOrWhiteSpace(_displayName))
        {
            return;
        }

        _isSubmitting = true;
        try
        {
            var request = new CompletePairingRequest
            {
                Token = _token.Trim(),
                DisplayName = _displayName.Trim(),
                PublicUrl = string.IsNullOrWhiteSpace(_publicUrl) ? null : _publicUrl.Trim(),
            };
            var result = await ApiClient.PostAsync<CompletePairingRequest, PairingStatusResponse>(
                "api/auth-proxy/pairing/complete", request);

            if (result.IsSuccess && result.Data is not null)
            {
                _status = result.Data;
                Snackbar.Add(L["settings.authProxyPairing.successToast"], Severity.Success);
                _token = string.Empty;
                _displayName = string.Empty;
                _publicUrl = string.Empty;
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? L["settings.authProxyPairing.failureToast"], Severity.Error);
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task ConfirmUnpair()
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            L["settings.authProxyPairing.unpairConfirmTitle"],
            L["settings.authProxyPairing.unpairConfirmBody"],
            yesText: L["common.unpair"],
            cancelText: L["common.cancel"]);
        if (confirm == true)
        {
            await ApiClient.DeleteAsync("api/auth-proxy/pairing");
            _status = null;
            Snackbar.Add(L["settings.authProxyPairing.unpairedToast"], Severity.Info);
        }
    }

    /// <summary>
    /// Days remaining until <paramref name="endsAt"/>, rounded up so a
    /// trial that ends today still reads as "1 day" until midnight. Clamps
    /// at 0 — past-due trials shouldn't render negative days.
    /// </summary>
    private static int ComputeDaysRemaining(DateTimeOffset? endsAt)
    {
        if (endsAt is null) return 0;
        var remaining = (endsAt.Value - DateTimeOffset.UtcNow).TotalDays;
        return Math.Max(0, (int)Math.Ceiling(remaining));
    }
}
