@using Famick.HomeManagement.Core.DTOs.Products
@using Famick.HomeManagement.Core.DTOs.ProductLookup
@using Famick.HomeManagement.Core.Interfaces
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject ILocalizer L

@*
    Parent-product picker. Bound single-select over the shared UnifiedProductSearch
    (General context = local + master catalog), excluding the current product. Resolves the
    chosen result to a tenant ProductDto, materializing master-catalog products and creating
    brand-new parents on demand.
*@

<UnifiedProductSearch Context="ProductSearchContext.General"
                      Label="@L["products.parentProduct"]"
                      HelperText="@HelperText"
                      Disabled="@(!CanEdit || IsParentProduct)"
                      ExcludeProductId="CurrentProductId"
                      ClearOnSelect="false"
                      SelectedText="@SelectedParentProduct?.Name"
                      AllowAddProduct="@CanCreate"
                      AddProductLabel="@L["products.createParent"]"
                      OnSelect="HandleSelect"
                      OnAddProduct="HandleAdd" />

@code {
    /// <summary>The currently selected parent product.</summary>
    [Parameter] public ProductDto? SelectedParentProduct { get; set; }

    /// <summary>Callback when the selected parent product changes.</summary>
    [Parameter] public EventCallback<ProductDto?> SelectedParentProductChanged { get; set; }

    /// <summary>The current product's ID (to exclude from search results).</summary>
    [Parameter] public Guid? CurrentProductId { get; set; }

    /// <summary>Whether the current product has child products (if true, cannot select a parent).</summary>
    [Parameter] public bool IsParentProduct { get; set; }

    /// <summary>Whether editing is allowed (false for Viewer role).</summary>
    [Parameter] public bool CanEdit { get; set; } = true;

    /// <summary>Location ID to use when creating a new parent product.</summary>
    [Parameter] public Guid? InheritedLocationId { get; set; }

    /// <summary>Stock quantity unit ID to use when creating a new parent product.</summary>
    [Parameter] public Guid? InheritedQuantityUnitIdStock { get; set; }

    /// <summary>Purchase quantity unit ID to use when creating a new parent product.</summary>
    [Parameter] public Guid? InheritedQuantityUnitIdPurchase { get; set; }

    /// <summary>Product group ID to use when creating a new parent product.</summary>
    [Parameter] public Guid? InheritedProductGroupId { get; set; }

    private bool CanCreate => CanEdit
        && InheritedLocationId.HasValue
        && InheritedQuantityUnitIdStock.HasValue
        && InheritedQuantityUnitIdPurchase.HasValue;

    private string HelperText => IsParentProduct
        ? L["products.cannotSetParentWithChildren"]
        : L["products.parentProductHint"];

    private async Task HandleSelect(ProductLookupResultDto result)
    {
        if (result.LocalProductId.HasValue)
        {
            var existing = await ApiClient.GetAsync<ProductDto>($"api/v1/products/{result.LocalProductId.Value}");
            if (existing.IsSuccess && existing.Data != null)
            {
                await SetSelectedAsync(existing.Data);
            }
        }
        else if (result.MasterProductId.HasValue)
        {
            var product = await EnsureProductFromMasterAsync(result.MasterProductId.Value);
            if (product != null)
            {
                await SetSelectedAsync(product);
                Snackbar.Add(L["products.parentAddedFromCatalog", product.Name], Severity.Success);
            }
        }
    }

    private async Task HandleAdd(string name)
    {
        var product = await CreateParentProductAsync(name);
        if (product != null)
        {
            await SetSelectedAsync(product);
        }
    }

    private async Task SetSelectedAsync(ProductDto product)
    {
        SelectedParentProduct = product;
        await SelectedParentProductChanged.InvokeAsync(product);
    }

    private async Task<ProductDto?> EnsureProductFromMasterAsync(Guid masterProductId)
    {
        var result = await ApiClient.PostAsync<object, ProductDto>(
            $"api/v1/products/from-master/{masterProductId}", new { });

        if (result.IsSuccess && result.Data != null)
        {
            return result.Data;
        }

        Snackbar.Add(result.ErrorMessage ?? L["errors.generic"], Severity.Error);
        return null;
    }

    private async Task<ProductDto?> CreateParentProductAsync(string name)
    {
        if (!InheritedLocationId.HasValue || !InheritedQuantityUnitIdStock.HasValue || !InheritedQuantityUnitIdPurchase.HasValue)
        {
            Snackbar.Add(L["products.cannotCreateParentMissingFields"], Severity.Warning);
            return null;
        }

        var request = new CreateProductRequest
        {
            Name = name,
            LocationId = InheritedLocationId.Value,
            QuantityUnitIdStock = InheritedQuantityUnitIdStock.Value,
            QuantityUnitIdPurchase = InheritedQuantityUnitIdPurchase.Value,
            QuantityUnitFactorPurchaseToStock = 1.0m,
            ProductGroupId = InheritedProductGroupId,
            MinStockAmount = 0,
            DefaultBestBeforeDays = 0,
            IsActive = true
        };

        var result = await ApiClient.PostAsync<CreateProductRequest, ProductDto>("api/v1/products", request);

        if (result.IsSuccess && result.Data != null)
        {
            Snackbar.Add(L["products.parentCreated", name], Severity.Success);
            return result.Data;
        }

        Snackbar.Add(result.ErrorMessage ?? L["errors.generic"], Severity.Error);
        return null;
    }
}
