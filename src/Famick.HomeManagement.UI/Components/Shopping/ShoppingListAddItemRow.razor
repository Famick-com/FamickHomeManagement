@using Famick.HomeManagement.Core.DTOs.Products
@using Famick.HomeManagement.Core.DTOs.ProductLookup
@using Famick.HomeManagement.Core.DTOs.ShoppingLists
@using Famick.HomeManagement.UI.Services
@using Famick.HomeManagement.UI.Components.Products
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject ILocalizer L

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
        <UnifiedProductSearch Context="ProductSearchContext.ShoppingList"
                              ShoppingListId="ShoppingListId"
                              ShoppingLocationId="ShoppingLocationId"
                              Label="@L["shopping.addItemSearch"]"
                              ClearOnSelect="false"
                              SelectedText="@_selectedName"
                              AllowAddProduct="true"
                              ShowExternalToggle="true"
                              Class="flex-grow-1"
                              OnSelect="OnProductSelected"
                              OnAddProduct="AddAsFreeText" />

        <MudNumericField T="decimal"
                         @bind-Value="_amount"
                         Label="@L["common.amount"]"
                         Variant="Variant.Outlined"
                         Min="0.01M"
                         Step="1"
                         Style="max-width: 120px;" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddSelectedProduct"
                   Disabled="@(_selectedResult == null || _isAdding)"
                   Style="height: 40px;">
            @if (_isAdding)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
            }
            @L["shopping.addToList"]
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public Guid ShoppingListId { get; set; }

    [Parameter]
    public Guid? ShoppingLocationId { get; set; }

    [Parameter]
    public EventCallback OnItemAdded { get; set; }

    private ProductLookupResultDto? _selectedResult;
    private string? _selectedName;
    private decimal _amount = 1;
    private bool _isAdding;

    private void OnProductSelected(ProductLookupResultDto result)
    {
        _selectedResult = result;
        _selectedName = result.Name;
    }

    private async Task AddSelectedProduct()
    {
        if (_selectedResult == null) return;

        var productId = await ResolveProductIdAsync(_selectedResult);
        if (productId.HasValue)
        {
            await AddItemToList(productId.Value, _selectedResult.Name);
        }
    }

    // Turns a picked result into a concrete tenant product id, materializing master-catalog
    // or store/external results on demand (deferred until the user commits with "Add").
    private async Task<Guid?> ResolveProductIdAsync(ProductLookupResultDto result)
    {
        if (result.LocalProductId.HasValue)
            return result.LocalProductId.Value;

        if (result.MasterProductId.HasValue)
        {
            var fromMaster = await ApiClient.PostAsync<object, ProductDto>(
                $"api/v1/products/from-master/{result.MasterProductId.Value}", new { });
            if (fromMaster.IsSuccess && fromMaster.Data != null)
                return fromMaster.Data.Id;

            Snackbar.Add(fromMaster.ErrorMessage ?? L["errors.generic"], Severity.Error);
            return null;
        }

        // Store / external result — create a product from the lookup data.
        var createRequest = new CreateProductFromLookupRequest
        {
            Name = result.Name,
            Brand = result.Brand,
            Description = result.Size,
            Barcodes = result.Barcodes.ToList(),
            OriginalSearchBarcode = result.OriginalSearchBarcode,
            Category = result.Category,
            ImageUrl = result.ImageUrl,
            ThumbnailUrl = result.ThumbnailUrl,
            ExternalId = result.ExternalId,
            SourceType = result.SourceType,
            PluginId = result.PluginId,
            ShoppingLocationId = ShoppingLocationId,
            Aisle = result.Aisle,
            Shelf = result.Shelf,
            Department = result.Department,
            Price = result.Price
        };

        var created = await ApiClient.PostAsync<CreateProductFromLookupRequest, ProductDto>(
            "api/v1/products/from-lookup", createRequest);
        if (created.IsSuccess && created.Data != null)
            return created.Data.Id;

        Snackbar.Add(created.ErrorMessage ?? L["errors.generic"], Severity.Error);
        return null;
    }

    private async Task AddAsFreeText(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return;

        _isAdding = true;
        StateHasChanged();

        try
        {
            var createRequest = new CreateProductFromLookupRequest { Name = name.Trim() };
            var createResult = await ApiClient.PostAsync<CreateProductFromLookupRequest, ProductDto>(
                "api/v1/products/from-lookup", createRequest);

            if (createResult.IsSuccess && createResult.Data != null)
            {
                await AddItemToList(createResult.Data.Id, createResult.Data.Name);
            }
            else
            {
                Snackbar.Add(createResult.ErrorMessage ?? L["errors.generic"], Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add(L["errors.generic"], Severity.Error);
        }
        finally
        {
            _isAdding = false;
        }
    }

    private async Task AddItemToList(Guid productId, string productName)
    {
        _isAdding = true;
        StateHasChanged();

        try
        {
            var request = new AddShoppingListItemRequest
            {
                ProductId = productId,
                Amount = _amount,
                ProductName = productName
            };

            var result = await ApiClient.PostAsync<AddShoppingListItemRequest, ShoppingListItemDto>(
                $"api/v1/shoppinglists/{ShoppingListId}/items", request);

            if (result.IsSuccess)
            {
                Snackbar.Add(L["shopping.productCreatedAndAdded", productName], Severity.Success);
                _selectedResult = null;
                _selectedName = null;
                _amount = 1;
                await OnItemAdded.InvokeAsync();
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? L["errors.generic"], Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add(L["errors.generic"], Severity.Error);
        }
        finally
        {
            _isAdding = false;
        }
    }
}
