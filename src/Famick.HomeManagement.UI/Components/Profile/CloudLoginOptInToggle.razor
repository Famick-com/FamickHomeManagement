@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject ILocalizer L
@using Famick.HomeManagement.Core.DTOs.CloudLogin

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_status is null || !_status.ServerIsPaired)
{
    @* Server not paired with AuthProxy — hide the toggle entirely.  *@
    @* Admin needs to complete Settings → Cloud Auth Pairing first.   *@
}
else
{
    <MudPaper Elevation="1" Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-2">@L["profile.cloudLogin.title"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            @L["profile.cloudLogin.description"]
        </MudText>
        <MudSwitch T="bool"
                   Value="@_status.UserIsOptedIn"
                   ValueChanged="OnToggled"
                   Color="Color.Primary"
                   Disabled="@_isToggling"
                   Label="@(_status.UserIsOptedIn ? L["profile.cloudLogin.enabled"] : L["profile.cloudLogin.disabled"])" />
    </MudPaper>
}

@code {
    private bool _isLoading = true;
    private bool _isToggling;
    private CloudLoginStatusResponse? _status;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        var result = await ApiClient.GetAsync<CloudLoginStatusResponse>("api/profile/cloud-login/status");
        _status = result.IsSuccess && result.Data is not null ? result.Data : null;
        _isLoading = false;
    }

    private async Task OnToggled(bool wantOptIn)
    {
        if (_status is null || _isToggling) return;
        _isToggling = true;
        try
        {
            var endpoint = wantOptIn ? "api/profile/cloud-login/opt-in" : "api/profile/cloud-login/opt-out";
            var result = await ApiClient.PostAsync<object, CloudLoginStatusResponse>(endpoint, new { });
            if (result.IsSuccess && result.Data is not null)
            {
                _status = result.Data;
                Snackbar.Add(
                    wantOptIn ? L["profile.cloudLogin.optInToast"] : L["profile.cloudLogin.optOutToast"],
                    Severity.Success);
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? L["profile.cloudLogin.toggleFailedToast"], Severity.Error);
            }
        }
        finally
        {
            _isToggling = false;
        }
    }
}
