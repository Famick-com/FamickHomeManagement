@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject ILocalizer L
@inject IJSRuntime JS
@using Famick.HomeManagement.Core.DTOs.Wizard
@using Famick.HomeManagement.Core.Platform

<MudStack Spacing="3">
    <MudText Typo="Typo.h6">@Title</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">@Description</MudText>

    <MudForm @ref="_form">
        <MudStack Spacing="3">
            @if (ShowPublicHostName)
            {
                <MudTextField @bind-Value="_publicHostName"
                              Label="@L["settings.serverSettings.publicHostName"]"
                              HelperText="@L["settings.serverSettings.publicHostNameHelp"]"
                              Variant="Variant.Outlined" />
            }

            <MudTextField @bind-Value="_timeZone"
                          Label="@L["settings.serverSettings.timeZone"]"
                          HelperText="@L["settings.serverSettings.timeZoneHelp"]"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="@L["validation.required", L["settings.serverSettings.timeZone"]]" />
        </MudStack>
    </MudForm>
</MudStack>

<MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-6">
    <MudButton Variant="Variant.Text"
               Color="Color.Default"
               OnClick="HandleExit">
        @L["common.exitSetup"]
    </MudButton>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="HandleNext"
               Disabled="@_isSaving">
        @if (_isSaving)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
        }
        @L["common.next"]
    </MudButton>
</MudStack>

@code {
    [Parameter] public ServerSetupDto? Data { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnExit { get; set; }

    private MudForm? _form;
    private bool _isSaving;
    // Public URL is optional (the web UI never needs it; it only matters for
    // external/mobile clients). Timezone is pre-filled by the server with its
    // detected zone.
    private string _publicHostName = string.Empty;
    private string _timeZone = "UTC";
    // Only a self-hosted operator owns the address their server answers on. Home Assistant
    // gets it from Supervisor's Ingress, and a hosted install has one fixed address that the
    // household does not choose, so the field is hidden rather than left optional.
    private ServerPlatform _platform = ServerPlatform.SelfHosted;
    private bool _detected;

    private bool ShowPublicHostName => _platform == ServerPlatform.SelfHosted;

    // Without the address field this step is only about the time zone, and calling it server
    // setup would name something the user has no server for.
    private string Title => ShowPublicHostName
        ? L["home.setupWizard.step.serverSetup"]
        : L["home.setupWizard.step.timeZoneOnly"];

    private string Description => ShowPublicHostName
        ? L["home.setupWizard.step.serverSetupDesc"]
        : L["home.setupWizard.step.timeZoneOnlyDesc"];

    protected override void OnParametersSet()
    {
        if (Data != null)
        {
            _publicHostName = Data.PublicHostName ?? string.Empty;
            _timeZone = string.IsNullOrWhiteSpace(Data.TimeZone) ? "UTC" : Data.TimeZone;
            _platform = Data.Platform;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _detected) return;
        _detected = true;

        // The server can only report its own zone, which on a hosted install is the container's
        // — usually UTC, and rarely where the household is. Only override that default: a zone
        // the operator actually chose is a deliberate answer and outranks the browser's guess.
        // "Etc/UTC" counts as the same non-answer, since that is what a container often reports.
        var unset = string.IsNullOrWhiteSpace(_timeZone)
            || string.Equals(_timeZone, "UTC", StringComparison.OrdinalIgnoreCase)
            || string.Equals(_timeZone, "Etc/UTC", StringComparison.OrdinalIgnoreCase);

        if (!unset) return;

        try
        {
            var detected = await JS.InvokeAsync<string?>("famickTimeZone.get");
            if (!string.IsNullOrWhiteSpace(detected))
            {
                _timeZone = detected;
                StateHasChanged();
            }
        }
        catch
        {
            // Detection is a convenience. Keep the default and let the user pick.
        }
    }

    private async Task HandleNext()
    {
        if (_form != null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        _isSaving = true;
        try
        {
            var request = new ServerSetupDto
            {
                PublicHostName = _publicHostName.Trim(),
                TimeZone = _timeZone.Trim(),
            };

            var result = await ApiClient.PutAsync<ServerSetupDto>("api/v1/wizard/server-setup", request);
            if (result.IsSuccess)
            {
                await OnNext.InvokeAsync();
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? L["common.error"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task HandleExit() => await OnExit.InvokeAsync();
}
