@page "/linked-households/accept"
@attribute [Authorize]
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject ILocalizer L
@inject NavigationManager Navigation

@* Where a request from another household to link with this one is accepted. The server's claim
   page sends someone here when the address the request went to has an account, or when they choose
   to link the household they have instead of making a new one; signing in comes first. *@

<PageTitle>@L["householdLinks.accept.title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_request == null)
    {
        <MudStack AlignItems="AlignItems.Center" Spacing="4" Class="pa-8">
            <MudIcon Icon="@Icons.Material.Filled.LinkOff" Size="Size.Large" Color="Color.Warning" />
            <MudText Typo="Typo.h5" Align="Align.Center">@L["householdLinks.accept.cantOpen"]</MudText>
            <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary">@L[HouseholdLinkRequests.ProblemKey(_problem)]</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GoHome">@L["householdLinks.accept.goHome"]</MudButton>
        </MudStack>
    }
    else
    {
        <MudCard Elevation="1">
            <MudCardContent>
                <MudStack Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" />
                    <MudText Typo="Typo.h5">@L["householdLinks.accept.heading", _request.FromHousehold]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @L["householdLinks.accept.sentBy", _request.InvitedBy, _request.SentTo]
                    </MudText>
                    <MudText Typo="Typo.body2">@L["householdLinks.accept.explain"]</MudText>
                </MudStack>
            </MudCardContent>
            @if (StatusMessage is { } status)
            {
                <MudCardContent>
                    <MudAlert Severity="Severity.Info" Dense="true">@status</MudAlert>
                </MudCardContent>
            }
            @if (ProblemMessage is { } problem)
            {
                <MudCardContent>
                    <MudAlert Severity="Severity.Warning" Dense="true">@problem</MudAlert>
                </MudCardContent>
            }
            <MudCardActions Class="pa-4">
                @if (_request.Status == HouseholdLinkRequestStatus.AlreadyLinked)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Href="/contacts">
                        @L["householdLinks.accept.goToContacts"]
                    </MudButton>
                }
                else if (_request.CanAccept)
                {
                    <MudStack Row="true" Spacing="2" Style="width: 100%" Justify="Justify.FlexEnd">
                        <MudButton Variant="Variant.Text" OnClick="GoHome" Disabled="@_accepting">@L["householdLinks.accept.notNow"]</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_accepting" OnClick="AcceptAsync">
                            @(_accepting ? L["householdLinks.accept.accepting"] : L["householdLinks.accept.accept"])
                        </MudButton>
                    </MudStack>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="GoHome">
                        @L["householdLinks.accept.goHome"]
                    </MudButton>
                }
            </MudCardActions>
        </MudCard>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private bool _loading = true;
    private bool _accepting;
    private HouseholdLinkRequestPreview? _request;
    private HouseholdLinkRequestProblem _problem;
    private string? _reason;
    private string? _requestedToken;
    private int _latestRead;

    /// <summary>Why the request can't be accepted here, when it is no fault of the member's.</summary>
    private string? StatusMessage => _request?.Status switch
    {
        HouseholdLinkRequestStatus.OwnHousehold => L["householdLinks.accept.problems.ownHousehold"],
        HouseholdLinkRequestStatus.AlreadyLinked => L["householdLinks.accept.problems.alreadyLinked", _request.FromHousehold],
        HouseholdLinkRequestStatus.Open when !_request.CanAccept => L["householdLinks.accept.problems.notAdmin"],
        _ => null
    };

    private string? ProblemMessage => _problem switch
    {
        HouseholdLinkRequestProblem.None => null,
        HouseholdLinkRequestProblem.Refused when !string.IsNullOrEmpty(_reason) => _reason,
        _ => L[HouseholdLinkRequests.ProblemKey(_problem)]
    };

    protected override async Task OnParametersSetAsync()
    {
        var token = Token ?? string.Empty;
        if (token == _requestedToken)
            return;

        _requestedToken = token;
        var read = ++_latestRead;
        _loading = true;
        _accepting = false;
        _request = null;
        _problem = HouseholdLinkRequestProblem.None;
        _reason = null;

        var loaded = string.IsNullOrEmpty(token)
            ? new HouseholdLinkRequestLoad(null, HouseholdLinkRequestProblem.NotFound)
            : await HouseholdLinkRequests.LoadAsync(ApiClient, token);

        // The page moved to another link meanwhile. Showing this answer would put one request on
        // the page while the button accepts the other.
        if (read != _latestRead)
            return;

        _request = loaded.Request;
        _problem = loaded.Problem;
        _loading = false;
    }

    // An empty Href renders a plain button that goes nowhere, so home is a navigation of its own.
    private void GoHome() => Navigation.NavTo("/");

    // Linking waits for the admin's click: opening a link alone never links anything.
    private async Task AcceptAsync()
    {
        // The button is disabled only once the page renders, and a second click can come first.
        if (_accepting || _request is not { CanAccept: true } || _requestedToken is not { Length: > 0 } token)
            return;

        _accepting = true;
        _problem = HouseholdLinkRequestProblem.None;
        _reason = null;

        var accepted = await HouseholdLinkRequests.AcceptAsync(ApiClient, token);
        if (accepted.Link != null)
        {
            Snackbar.Add(L["householdLinks.accept.accepted", accepted.Link.Household], Severity.Success);
            Navigation.NavTo("/contacts");
            return;
        }

        if (token != _requestedToken)
            return;

        _problem = accepted.Problem;
        _reason = accepted.Reason;
        _accepting = false;
    }
}
