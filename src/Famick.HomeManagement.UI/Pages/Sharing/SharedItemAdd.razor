@page "/shares/add/{Token}"
@attribute [Authorize]
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject ILocalizer L
@inject NavigationManager Navigation

<PageTitle>@L["sharing.add.title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="pa-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_preview == null)
    {
        <MudStack AlignItems="AlignItems.Center" Spacing="4" Class="pa-8">
            <MudIcon Icon="@Icons.Material.Filled.LinkOff" Size="Size.Large" Color="Color.Warning" />
            <MudText Typo="Typo.h5" Align="Align.Center">@L["sharing.add.cantOpen"]</MudText>
            <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary">@ProblemMessage</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="">@L["sharing.add.goHome"]</MudButton>
        </MudStack>
    }
    else
    {
        <MudCard Elevation="1">
            @if (_preview.Item.HasImage)
            {
                <MudCardMedia Image="@SharedItemLinks.ImageEndpoint(Token)" Height="220" />
            }
            <MudCardContent>
                <MudStack Spacing="2">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0 align-self-start">
                        @L[SharedItemLinks.KindKey(_preview.Item.Kind)]
                    </MudChip>
                    <MudText Typo="Typo.h5">@_preview.Item.Name</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @L["sharing.add.sharedBy", _preview.Item.SharedByHouseholdName]
                    </MudText>
                    @if (_preview.SingleUse)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["sharing.add.singleUse"]</MudText>
                    }
                    <MudText Typo="Typo.body2">@L["sharing.add.explain"]</MudText>
                </MudStack>
            </MudCardContent>
            @if (IsContact)
            {
                <MudCardContent Class="pt-0">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">@L["sharing.add.placement.title", _preview.Item.Name]</MudText>
                    <MudRadioGroup @bind-Value="_destination">
                        @* The group sizes to its widest label; the fields under the choices use the card's width. *@
                        <MudStack Spacing="1" Style="width: 100%">
                            <MudRadio Value="@Destination.NewHousehold" Color="Color.Primary" Dense="true">
                                @L["sharing.add.placement.newHousehold"]
                            </MudRadio>
                            @if (_destination == Destination.NewHousehold)
                            {
                                <MudTextField @bind-Value="_newHouseholdName"
                                              Label="@L["sharing.add.placement.householdName"]"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              MaxLength="200"
                                              Immediate="true"
                                              FullWidth="true"
                                              Class="pl-8" />
                            }
                            @if (_hasOtherHouseholds)
                            {
                                <MudRadio Value="@Destination.ExistingHousehold" Color="Color.Primary" Dense="true">
                                    @L["sharing.add.placement.existingHousehold"]
                                </MudRadio>
                                @if (_destination == Destination.ExistingHousehold)
                                {
                                    <MudAutocomplete T="ContactGroupSummaryDto"
                                                     Label="@L["sharing.add.placement.searchHouseholds"]"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     SearchFunc="SearchHouseholdsAsync"
                                                     ToStringFunc="@(g => g?.GroupName ?? string.Empty)"
                                                     @bind-Value="_household"
                                                     ShowProgressIndicator="true"
                                                     DebounceInterval="300"
                                                     FullWidth="true"
                                                     Class="pl-8">
                                        <ItemTemplate Context="household">
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.body2">@household.GroupName</MudText>
                                                @if (household.MemberFirstNames.Count > 0)
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@string.Join(", ", household.MemberFirstNames)</MudText>
                                                }
                                            </MudStack>
                                        </ItemTemplate>
                                        <NoItemsTemplate>
                                            <MudText Typo="Typo.body2" Class="pa-2">@L["sharing.add.placement.noHouseholds"]</MudText>
                                        </NoItemsTemplate>
                                    </MudAutocomplete>
                                }
                            }
                            <MudRadio Value="@Destination.MyHousehold" Color="Color.Primary" Dense="true">
                                @L["sharing.add.placement.myHousehold"]
                            </MudRadio>
                        </MudStack>
                    </MudRadioGroup>
                </MudCardContent>
            }
            @if (_problem != SharedLinkProblem.None)
            {
                <MudCardContent>
                    <MudAlert Severity="Severity.Warning" Dense="true">@ProblemMessage</MudAlert>
                </MudCardContent>
            }
            <MudCardActions Class="pa-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           Disabled="@(_adding || !Chosen)" OnClick="AddAsync">
                    @(_adding ? L["sharing.add.adding"] : IsContact ? L["sharing.add.addContact"] : L["sharing.add.add"])
                </MudButton>
            </MudCardActions>
        </MudCard>
    }
</MudContainer>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private bool _loading = true;
    private bool _adding;
    private SharedLinkPreview? _preview;
    private SharedLinkProblem _problem;
    private string? _requiredPlan;
    private string? _requestedToken;
    private int _latestRead;

    /// <summary>Where a shared contact goes in the household's contacts.</summary>
    public enum Destination
    {
        /// <summary>Most shared contacts are people from outside the home, so this comes first.</summary>
        NewHousehold,
        ExistingHousehold,
        MyHousehold
    }

    private Destination _destination = Destination.NewHousehold;
    private string _newHouseholdName = string.Empty;
    private ContactGroupSummaryDto? _household;
    private bool _hasOtherHouseholds;

    private bool IsContact => _preview?.Item.Kind == SharedItemKind.Contact;

    /// <summary>Whether a contact has somewhere to go; anything else always does.</summary>
    private bool Chosen => !IsContact || _destination switch
    {
        Destination.NewHousehold => !string.IsNullOrWhiteSpace(_newHouseholdName),
        Destination.ExistingHousehold => _household != null,
        _ => true
    };

    private SharedContactPlacement? Placement => !IsContact ? null : _destination switch
    {
        Destination.NewHousehold => new SharedContactPlacement(NewHouseholdName: _newHouseholdName.Trim()),
        Destination.ExistingHousehold when _household != null => new SharedContactPlacement(HouseholdId: _household.Id),
        _ => null
    };

    private string ProblemMessage => _problem == SharedLinkProblem.PlanRequired && _requiredPlan != null
        ? L["sharing.problems.planRequiredNamed", _requiredPlan]
        : L[SharedItemLinks.ProblemKey(_problem)];

    protected override async Task OnParametersSetAsync()
    {
        // Only another link is read again, so a re-render can't wipe what an add just reported.
        if (Token == _requestedToken)
            return;

        var token = _requestedToken = Token;
        var read = ++_latestRead;
        _loading = true;
        _adding = false;
        _preview = null;
        _problem = SharedLinkProblem.None;
        _requiredPlan = null;
        _destination = Destination.NewHousehold;
        _household = null;
        _hasOtherHouseholds = false;

        var loaded = await SharedItemLinks.LoadAsync(ApiClient, token);

        // The page moved to another link meanwhile. Showing this answer would put one item on the
        // page while the button adds the other.
        if (read != _latestRead)
            return;

        if (loaded.Preview is { Item.Kind: SharedItemKind.Contact } contact)
        {
            _newHouseholdName = contact.Item.SuggestedHouseholdName ?? contact.Item.Name;

            // Two are enough to know: one of them may be the household's own.
            var households = await SharedItemLinks.SearchHouseholdsAsync(ApiClient, null, max: 2);
            if (read != _latestRead)
                return;
            _hasOtherHouseholds = households.Count > 0;
        }

        _preview = loaded.Preview;
        _problem = loaded.Problem;
        _loading = false;
    }

    private async Task<IEnumerable<ContactGroupSummaryDto>> SearchHouseholdsAsync(string? search, CancellationToken ct) =>
        await SharedItemLinks.SearchHouseholdsAsync(ApiClient, search);

    // Adding waits for the member's click: a link alone never adds anything to the household.
    private async Task AddAsync()
    {
        // The button is disabled only once the page renders, and a second click can come first.
        if (_adding || !Chosen)
            return;

        var token = Token;
        _adding = true;
        _problem = SharedLinkProblem.None;

        var added = await SharedItemLinks.AddAsync(ApiClient, token, Placement);
        if (added.Copy != null)
        {
            Snackbar.Add(added.Copy.AlreadyHad
                ? L["sharing.add.alreadyHad", added.Copy.Name]
                : L["sharing.add.added", added.Copy.Name], Severity.Success);
            Navigation.NavTo(SharedItemLinks.CopyRoute(added.Copy));
            return;
        }

        if (token != _requestedToken)
            return;

        _problem = added.Problem;
        _requiredPlan = added.RequiredPlan;
        _adding = false;
    }
}
