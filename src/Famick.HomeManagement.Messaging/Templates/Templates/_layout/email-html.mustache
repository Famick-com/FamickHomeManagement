{{!
    Shared email shell.

    Core styling and layout are inline on the elements. Support for embedded stylesheets is
    uneven — Gmail's mobile app strips <style> for non-Gmail accounts — and everything the
    branding depends on used to live there, so those clients received unstyled text.

    The stylesheet is kept for what inline cannot express: the prefers-color-scheme block. Its
    rules carry !important because a stylesheet cannot otherwise override an inline style. Class
    names are retained purely so those rules have something to select.

    The header is a table rather than a flex row. Flexbox is not reliable in email clients, and
    a single-row table is the layout primitive they all agree on.
}}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="color-scheme" content="light dark">
    <meta name="supported-color-schemes" content="light dark">
    <style>
        :root { color-scheme: light dark; }
        @media (prefers-color-scheme: dark) {
            .body-text { color: #e0e0e0 !important; }
            .header { background-color: #2D4A2D !important; }
            .button { background-color: #7BA17C !important; color: #10231A !important; }
            .credentials, .token-box, th { background-color: #2a2a2a !important; }
            .compliance-footer { border-top-color: #333 !important; }
            .compliance-footer, .compliance-footer a { color: #777 !important; }
            .footer { color: #999 !important; }
            .warning, .section-heading.warning { color: #ef5350 !important; }
            .item { border-bottom-color: #333 !important; }
            .item-meta { color: #999 !important; }
        }
    </style>
</head>
<body class="body-text" style="font-family: Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #333333; margin: 0; padding: 0;">
    <div class="email-wrapper" style="max-width: 640px; margin: 0 auto;">
        <table class="header" role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #518751; border-collapse: collapse;">
            <tr>
                {{#complianceFooter}}
                <td style="padding: 14px 0 14px 24px; width: 38px; vertical-align: middle;">
                    <img src="{{BaseUrl}}/_content/Famick.HomeManagement.UI/images/icon.svg" alt="Famick" height="28" style="height: 28px; display: block;" />
                </td>
                {{/complianceFooter}}
                <td style="padding: 14px 24px; vertical-align: middle;">
                    <span class="header-text" style="color: #ffffff; font-size: 18px; font-weight: 500;">Famick Home Management</span>
                </td>
            </tr>
        </table>
        <div class="container" style="padding: 28px 24px 24px;">
            {{{content}}}
        </div>
        {{#complianceFooter}}
        <div class="compliance-footer" style="padding: 20px 24px; border-top: 1px solid #e0e0e0; font-size: 11px; color: #999999; line-height: 1.5;">
            <p style="margin: 0 0 8px;">You are receiving this email because you have an account with {{CompanyName}} and this notification type is enabled in your preferences.</p>
            {{#UnsubscribeUrl}}<p style="margin: 0 0 8px;"><a href="{{UnsubscribeUrl}}" style="color: #999999;">Unsubscribe</a> from this type of notification, or manage your <a href="{{PreferencesUrl}}" style="color: #999999;">notification preferences</a>.</p>{{/UnsubscribeUrl}}
            {{#PhysicalAddress}}<p style="margin: 0 0 8px;">{{CompanyName}}, {{PhysicalAddress}}</p>{{/PhysicalAddress}}
            {{#PrivacyPolicyUrl}}<p style="margin: 0;"><a href="{{PrivacyPolicyUrl}}" style="color: #999999;">Privacy Policy</a></p>{{/PrivacyPolicyUrl}}
        </div>
        {{/complianceFooter}}
    </div>
</body>
</html>
