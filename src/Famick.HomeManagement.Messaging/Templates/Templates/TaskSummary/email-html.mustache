<h2>Daily Task Summary</h2>
<p>You have {{TotalTasks}} pending task(s):</p>
<ul>
    {{#HasTodos}}<li>{{IncompleteTodos}} incomplete todo(s)</li>{{/HasTodos}}
    {{#HasChores}}<li>{{OverdueChores}} overdue chore(s)</li>{{/HasChores}}
    {{#HasMaintenance}}<li>{{OverdueMaintenance}} overdue vehicle maintenance item(s)</li>{{/HasMaintenance}}
</ul>
{{#DeepLinkUrl}}<a href="{{BaseUrl}}{{DeepLinkUrl}}" class="button" style="display:inline-block;padding:14px 28px;background-color:#518751;color:#ffffff;text-decoration:none;border-radius:4px;margin:20px 0;font-size:15px;">View Tasks</a>{{/DeepLinkUrl}}
