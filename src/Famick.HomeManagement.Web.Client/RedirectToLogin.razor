@inject NavigationManager Navigation
@inject IApiClient ApiClient
@inject ApiAuthStateProvider AuthStateProvider
@inject PlatformState PlatformState

@code {
    // Attempt HA Ingress SSO at most once per app load, so a token the client
    // somehow doesn't honor can't turn into a redirect loop. A static field on
    // a WASM component persists for the page's app lifetime.
    private static bool _ssoAttempted;

    protected override async Task OnInitializedAsync()
    {
        // Home Assistant Ingress single sign-on. Under the add-on the server
        // signs us in from the trusted Supervisor headers; outside Ingress the
        // endpoint returns 404/401 and we fall through to setup/login as usual.
        if (!_ssoAttempted)
        {
            _ssoAttempted = true;
            var sso = await ApiClient.TryHaIngressSsoAsync();
            if (sso.IsSuccess)
            {
                await AuthStateProvider.NotifyAuthenticationStateChangedAsync();
                Navigation.NavTo("/");
                return;
            }
        }

        try
        {
            // Check if setup is required (no users exist)
            var setupResult = await ApiClient.GetSetupStatusAsync();
            if (setupResult.IsSuccess && setupResult.Data is not null)
            {
                // Prime the platform cache from the boot status so pages don't re-fetch.
                PlatformState.Set(setupResult.Data.Platform);

                if (setupResult.Data.SetupRequired)
                {
                    Navigation.NavTo("/setup");
                    return;
                }
            }
        }
        catch
        {
            // If setup check fails, continue to login
        }

        // Redirect to login page. Build an app-absolute returnUrl (leading
        // slash) so RedirectUrlValidator accepts it on the login side; NavTo
        // converts it to base-relative when the login page navigates there,
        // so it round-trips under HA Ingress as well as at the site root.
        var returnUrl = Uri.EscapeDataString("/" + Navigation.ToBaseRelativePath(Navigation.Uri));
        Navigation.NavTo($"/login?returnUrl={returnUrl}");
    }
}
