# Famick Home Management - Environment Configuration
# Copy this file to .env and update the values, or run setup.sh to auto-generate secrets.

# Host ports the web app listens on. Defaults avoid common conflicts:
# 8088 instead of 80/88 (port 88 is the macOS Kerberos KDC), 4431 instead of 443.
HTTP_PORT=8088
HTTPS_PORT=4431

# Database
DB_PASSWORD=changeme123

# The address this server is reachable at from outside, e.g. https://home.example.com
# or http://192.168.1.50:8088. Used only for links that leave the building: the
# "your data export is ready" email is the one that matters today.
#
# The app cannot work this out for itself — the export runs in a background job with no
# request to read a host from. Left empty, that email is not sent, and the archive is
# still downloadable from Settings.
#
# If this server is reachable from the public internet, use https. The link carries a
# token good for the whole archive, and it is not emailed over plain http to a public
# address. Plain http to a private one — a LAN IP, a bare hostname, *.local — is fine,
# since everything else on that install already travels the same way.
BASE_URL=

# Per-install tenant ID. Generated by setup.sh on first run; the same UUID
# is plumbed into both FixedTenantId (Program.cs) and SelfHosted__TenantId
# (AuthenticationService, ExternalAuthService, PasskeyService) via compose
# variable substitution below. Don't change this after the first
# `docker compose up -d` — every Tenants / Users / Homes / etc. row in
# postgres carries this UUID as a foreign key.
TENANT_ID=00000000-0000-0000-0000-000000000001

# JWT Authentication (legacy symmetric key, kept for backwards compatibility)
JWT_SECRET_KEY=your-secret-key-change-this-min-32-characters-long

# HTTPS Certificate
CERT_PASSWORD=password

# Email (optional - required for password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true
SMTP_FROM_EMAIL=noreply@localhost
SMTP_FROM_NAME=Famick Home Management

# pgAdmin (optional - only used with --profile tools)
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin

# TLS mode (uncomment to enable Kestrel-side HTTPS):
# When set, docker compose reads this and applies docker-compose.app-tls.yml on
# top of docker-compose.yml. To switch modes later, edit this line and run
# `docker compose up -d` again. install-docker.sh writes this for you when
# "app-level TLS" is selected at install time.
# COMPOSE_FILE=docker-compose.yml:docker-compose.app-tls.yml
