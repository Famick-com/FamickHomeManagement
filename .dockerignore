# Build artifacts
**/bin/
**/obj/
**/Debug/
**/Release/

# IDE
.vs/
.vscode/
*.user
*.suo

# macOS
.DS_Store

# Git
.git/
.gitignore
.github/

# NuGet packages (restored during build)
*.nupkg
packages/

# Test projects (not needed for production image)
tests/

# Cloud submodule (not needed for self-hosted image)
homemanagement-cloud/

# Mobile app (not needed for web image)
src/Famick.HomeManagement.Mobile/

# Scripts and docs
scripts/
docs/
*.md
LICENSE
COPYRIGHT

# Exclude self-hosted/ except the files the Dockerfile COPYs in
# (scheduler-crontab + admin-cli + HA-addon bootstrap script). Negation lines
# must come after the directory exclusion or buildkit ignores them.
self-hosted/
!self-hosted/docker-compose/scheduler-crontab
!self-hosted/docker-compose/admin-cli
!self-hosted/home-assistant-plugin/bootstrap.sh

# Certificates and secrets
*.pem
*.p12
*.p8
*.cer
**/secrets.tfvars
**/google-services.json
**/GoogleService-Info.plist

# Misc
.claude/
.clj-kondo/
.lsp/
**/logs/

# Xcode / Widget
**/WidgetExtension/XReleases/
**/WidgetExtension/build/
*.xcworkspace/
*.xcodeproj/
DerivedData/
