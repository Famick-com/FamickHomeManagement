<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- This project lives under tests/ and references xunit so consumers can
         use IClassFixture<T> against its Testcontainers fixtures, but the
         project itself contains no tests.
         VS Code's C# Dev Kit Test Explorer probes every assembly with an xunit
         reference and tries to launch testhost on it. Setting IsTestProject=false
         was previously used to opt out, but the discoverer still attempts the
         launch and fails when testhost.dll isn't next to the assembly.
         The robust fix is to ship the same test-host artifacts (testhost.dll,
         xunit.runner.visualstudio) that real test projects ship: VSTest
         discovers zero tests in this assembly and exits cleanly.
         CopyLocalLockFileAssemblies=true keeps transitive runtime DLLs
         (AWSSDK.Core via Infrastructure → AWSSDK.SimpleEmailV2) next to the
         assembly so deps.json resolution succeeds when loaded outside its
         referencing test project. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.17.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.17.0" />
    <!-- Pinned, not used directly: Testcontainers pulls SSH.NET in transitively at a
         version affected by GHSA-8cw4-jj4c-r5c8 (ScpClient recursive download can write
         outside the target directory). Test-only, but it keeps the alert list honest.
         Remove once Testcontainers resolves a patched version on its own. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.11.0" />
    <PackageReference Include="Testcontainers.Redis" Version="4.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Famick.HomeManagement.Core\Famick.HomeManagement.Core.csproj" />
    <ProjectReference Include="..\..\src\Famick.HomeManagement.Infrastructure\Famick.HomeManagement.Infrastructure.csproj" />
  </ItemGroup>

</Project>
