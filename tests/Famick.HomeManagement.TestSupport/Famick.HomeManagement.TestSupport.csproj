<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- This project is a support library (Testcontainers fixtures, JwtTestHelpers)
         that lives under tests/ but contains no tests itself. Two settings opt it
         out of test discovery and ensure its bin folder is self-contained when VS
         Code's C# Dev Kit nevertheless tries to load it:
         - IsTestProject=false: tells VSTest this is not a test assembly.
         - CopyLocalLockFileAssemblies=true: copies all transitive runtime DLLs
           (AWSSDK.Core etc., pulled via Infrastructure → AWSSDK.SimpleEmailV2)
           into the bin folder so deps.json resolution succeeds even when the
           assembly is loaded outside its referencing test project. Without this,
           libraries don't copy transitive package DLLs by default and the test
           host fails with "package not found" at the deps.json path. -->
    <IsTestProject>false</IsTestProject>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.17.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.17.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.11.0" />
    <PackageReference Include="Testcontainers.Redis" Version="4.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Famick.HomeManagement.Core\Famick.HomeManagement.Core.csproj" />
    <ProjectReference Include="..\..\src\Famick.HomeManagement.Infrastructure\Famick.HomeManagement.Infrastructure.csproj" />
  </ItemGroup>

</Project>
