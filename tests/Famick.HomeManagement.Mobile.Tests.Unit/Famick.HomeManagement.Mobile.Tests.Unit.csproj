<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Mobile purchase tests.

    Separate from Shared.Tests.Unit on purpose. Reaching the store SDK means referencing
    Kebechet.Maui.RevenueCat.InAppBilling, whose platform-neutral asset depends on
    Microsoft.Maui.Controls — and MAUI's global usings collide with the domain there
    (Contact, among others). Keeping it in its own project leaves that suite alone.

    Plain net10.0, no MAUI workload: the store SDK is reached through an interface, and the
    purchase service holds no MAUI types of its own — what it needs of its surroundings is
    behind IStoreConfiguration.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="8.0.1" />
    <PackageReference Include="FluentAssertions" Version="8.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Kebechet.Maui.RevenueCat.InAppBilling" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Famick.HomeManagement.Core\Famick.HomeManagement.Core.csproj" />
  </ItemGroup>

  <!--
    Source-linked rather than project-referenced: the mobile project targets iOS and
    Android and cannot be referenced from a plain net10.0 assembly. Same arrangement the
    shared suite uses for the address autocomplete controller.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Famick.HomeManagement.Mobile\Services\IPurchaseService.cs"
             Link="MobileLinked\IPurchaseService.cs" />
    <Compile Include="..\..\src\Famick.HomeManagement.Mobile\Services\IStoreConfiguration.cs"
             Link="MobileLinked\IStoreConfiguration.cs" />
    <Compile Include="..\..\src\Famick.HomeManagement.Mobile\Services\PlanCopy.cs"
             Link="MobileLinked\PlanCopy.cs" />
    <Compile Include="..\..\src\Famick.HomeManagement.Mobile\Services\PurchaseService.cs"
             Link="MobileLinked\PurchaseService.cs" />
  </ItemGroup>

</Project>
